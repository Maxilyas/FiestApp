diff --git a/client/src/components/JourEtDefi.tsx b/client/src/components/JourEtDefi.tsx
new file mode 100644
index 0000000..ad57559
--- /dev/null
+++ b/client/src/components/JourEtDefi.tsx
@@ -0,0 +1,299 @@
+import { useEffect, useState, type ReactNode } from 'react'
+import { api } from '../api'
+import { Icon } from './Icon'
+import { GrosBouton } from './Pieces'
+import { Avatar } from './Avatar'
+import { Onglets } from './Onglets'
+import { ontGagneHier } from './Jour'
+import { espacesFines, formatNumber, pts } from '../format'
+import { placeDuJour } from '../../../shared/course'
+import { enumerer } from '../../../shared/classement'
+import type { CarriereDuJour, PartieDuJour } from '../../../shared/jour'
+import type { DefiDeLaSemaine, LigneDuDefi } from '../../../shared/campagne'
+
+// Maquette du 19 octobre 2026 — le quiz du jour et le défi de la semaine au
+// même endroit de l'accueil, en onglets, le quiz du jour d'office : rangé au
+// troisième onglet de la campagne, le défi, beaucoup ne savaient pas qu'il
+// existait (le propriétaire). Deux allures, essayées sur le téléphone par
+// `quizz.maquette` : `tuile` — deux onglets fins posés sur la tuile
+// d'aujourd'hui, à sa place —, `carte` — un classeur à deux onglets en tête
+// de « Seul », qui dit où en est la salle et a son bouton.
+
+export type Maquette = 'tuile' | 'carte'
+
+/** L'allure essayée sur ce téléphone, s'il y en a une. */
+export function maquetteEssayee(): Maquette | null {
+  try {
+    const m = localStorage.getItem('quizz.maquette')
+    return m === 'tuile' || m === 'carte' ? m : null
+  } catch {
+    return null
+  }
+}
+
+/** La page du défi, qui a quitté les onglets de la campagne. */
+const PAGE_DU_DEFI = '/campagne#defi'
+
+type Lequel = 'jour' | 'defi'
+
+const bonnes = (n: number) => `${n > 1 ? 'bonnes' : 'bonne'} réponse${n > 1 ? 's' : ''}`
+const nBonnes = (n: number) => `${n} ${bonnes(n)}`
+/** « 4ᵉ place sur 10 » d'un bloc : coupée, elle laissait « 10 » seul sur sa ligne. */
+const dUnBloc = (s: string) => s.replace(/ /g, ' ')
+
+/** « clôture dans 4 jours » : ce qui reste au défi, à l'heure de Paris. */
+function cloture(minutes: number): string {
+  if (minutes < 60) return `clôture dans ${minutes} min`
+  if (minutes < 24 * 60) return 'clôture ce soir à minuit'
+  const jours = Math.floor(minutes / (24 * 60))
+  return `clôture dans ${jours} jour${jours > 1 ? 's' : ''}`
+}
+
+/** Où il en est du défi : rien d'ouvert, une tentative à reprendre, ou relevé — sa ligne au classement. */
+function sonDefi(d: DefiDeLaSemaine) {
+  const t = d.tentative
+  const sienne = [...d.lignes, ...(d.moi ? [d.moi] : [])].find(l => l.profileId === d.sienne)
+  return { t, sienne, etat: !t ? ('a-relever' as const) : t.finie ? ('releve' as const) : ('a-finir' as const) }
+}
+
+/**
+ * « Hugo mène le classement », son score au bout, comme au classement —
+ * tous les ex æquo en tête (invariant 15), lui compris. « avec 11 bonnes
+ * réponses » en toutes lettres passait sur deux lignes en 360.
+ */
+function laTete(d: DefiDeLaSemaine): { lignes: LigneDuDefi[]; texte: string; justes: number } | null {
+  const tete = d.lignes.filter(l => l.rang === 1 && l.justes > 0)
+  if (tete.length === 0) return null
+  const noms = tete.map(l => (l.profileId === d.sienne ? 'toi' : l.nom))
+  const toi = noms.length === 1 && noms[0] === 'toi'
+  const sujet = toi ? 'Tu' : enumerer(noms).replace(/^toi/, 'Toi')
+  const verbe = toi ? 'mènes' : tete.length > 1 ? 'mènent' : 'mène'
+  return { lignes: tete, texte: `${sujet} ${verbe} le classement`, justes: tete[0].justes }
+}
+
+export function JourEtDefi({ maquette, jour, aujourdhui }: { maquette: Maquette; jour?: CarriereDuJour; aujourdhui?: string }) {
+  // D'office, le quiz du jour — le rendez-vous de chaque matin ; rien ne se
+  // retient : l'accueil rouvre toujours sur lui.
+  const [lequel, setLequel] = useState<Lequel>('jour')
+  const [defi, setDefi] = useState<DefiDeLaSemaine | null>(null)
+  const [partie, setPartie] = useState<PartieDuJour | null>(null)
+  useEffect(() => {
+    let vivant = true
+    // Le défi part en fond dès l'accueil montré : son onglet a son point avant d'être touché.
+    api.campagne
+      .defi()
+      .then(d => vivant && setDefi(d))
+      .catch(() => {})
+    if (maquette === 'carte')
+      api.jour
+        .etat()
+        .then(p => vivant && setPartie(p))
+        .catch(() => {})
+    return () => {
+      vivant = false
+    }
+  }, [maquette])
+
+  const dernier = jour?.jours[0]
+  const joueAujourdhui = !!dernier && !!aujourdhui && dernier.jour === aujourdhui
+  const etatDuDefi = defi ? sonDefi(defi).etat : null
+  const onglets = (
+    <Onglets
+      onglets={[
+        { id: 'jour', nom: 'Quiz du jour', ...(jour && !joueAujourdhui && { point: 'à jouer' }) },
+        { id: 'defi', nom: 'Défi de la semaine', ...(etatDuDefi && etatDuDefi !== 'releve' && { point: etatDuDefi === 'a-finir' ? 'à finir' : 'à relever' }) },
+      ]}
+      actif={lequel}
+      onChoisir={setLequel}
+      label="Le quiz du jour et le défi de la semaine"
+      idOnglet={l => `jour-defi-${l}`}
+      idPanneau={l => `jour-defi-panneau-${l}`}
+      className={maquette === 'tuile' ? 'onglets-fins' : 'onglets-classeur'}
+    />
+  )
+  // Les deux panneaux tiennent la même case, l'autre caché : le bloc garde la
+  // hauteur du plus grand, et changer d'onglet ne fait rien sauter dessous —
+  // le pouce qui visait « Les duels » les touche encore.
+  const panneaux = (jourEnPanneau: ReactNode, defiEnPanneau: ReactNode) => (
+    <div className="jour-defi-panneaux">
+      {(
+        [
+          ['jour', jourEnPanneau],
+          ['defi', defiEnPanneau],
+        ] as const
+      ).map(([l, contenu]) => (
+        <div key={l} id={`jour-defi-panneau-${l}`} role="tabpanel" aria-labelledby={`jour-defi-${l}`} aria-hidden={l !== lequel || undefined} className="jour-defi-panneau">
+          {contenu}
+        </div>
+      ))}
+    </div>
+  )
+
+  if (maquette === 'tuile') {
+    const serie = jour && jour.serie > 1 ? ` · série de ${jour.serie} jours` : ''
+    return (
+      <section className="jour-defi jour-defi-tuile">
+        {onglets}
+        {panneaux(
+          <GrosBouton
+            icone={<Icon name="sun" />}
+            titre="Le quiz du jour"
+            detail={joueAujourdhui ? `Joué aujourd’hui${serie}` : `Dix questions, les mêmes pour tous${serie}`}
+            pastille={jour && !joueAujourdhui ? 'À jouer' : undefined}
+            href="/jour"
+          />,
+          <TuileDuDefi defi={defi} />,
+        )}
+      </section>
+    )
+  }
+  return (
+    <section className="jour-defi jour-defi-carte">
+      {onglets}
+      {panneaux(<PanneauDuJour partie={partie} />, <PanneauDuDefi defi={defi} />)}
+    </section>
+  )
+}
+
+/** La tuile du défi, faite comme les autres : ce qu'il est, où en est la salle — ou le sien. */
+function TuileDuDefi({ defi }: { defi: DefiDeLaSemaine | null }) {
+  if (!defi) return <GrosBouton icone={<Icon name="trophy" />} titre="Le défi de la semaine" detail="La même série pour tous, jusqu’à dimanche" href={PAGE_DU_DEFI} />
+  const { t, sienne, etat } = sonDefi(defi)
+  const n = defi.joueurs
+  const releve = n > 1 ? `${n} joueurs l’ont relevé` : n === 1 ? 'un joueur l’a relevé' : 'à toi d’ouvrir le bal'
+  const place = sienne && placeDuJour(sienne.rang, n, sienne.justes)
+  // Deux lignes au plus en 360, comme les autres tuiles : son titre en prend déjà deux, à côté de sa pastille.
+  const detail =
+    etat === 'a-relever'
+      ? `${releve.charAt(0).toUpperCase()}${releve.slice(1)} · jusqu’à dimanche`
+      : etat === 'a-finir'
+        ? `${nBonnes(t!.justes)} : reprends-le`
+        : `${nBonnes(t!.justes)}${place ? ` · ${dUnBloc(place)}` : ''}`
+  return (
+    <GrosBouton
+      icone={<Icon name="trophy" />}
+      titre="Le défi de la semaine"
+      detail={espacesFines(detail)}
+      pastille={etat === 'a-relever' ? 'À relever' : etat === 'a-finir' ? 'À finir' : undefined}
+      href={PAGE_DU_DEFI}
+    />
+  )
+}
+
+/** Le chiffre du moment, en grand, comme au héros du défi : ce qu'il dit, en deux lignes à côté. */
+function Chiffre({ n, haut, bas }: { n: number; haut: string; bas: string }) {
+  return (
+    <div className="jd-hud">
+      <b>{formatNumber(n)}</b>
+      <span>
+        <span className="jd-hud-haut">{espacesFines(haut)}</span>
+        <span className="jd-hud-bas">{espacesFines(bas)}</span>
+      </span>
+    </div>
+  )
+}
+
+/** Où en est la salle — qui mène, qui a joué —, une ligne qui ouvre le classement ; un score au bout, comme au classement. */
+function LaSalle({ href, avant, texte, score }: { href: string; avant: ReactNode; texte: string; score?: { n: number; dit: string } }) {
+  return (
+    <a className="jd-salle" href={href}>
+      {avant}
+      <span className="jd-salle-texte">{espacesFines(texte)}</span>
+      {score && (
+        <span className="jd-salle-score">
+          {score.n}
+          <span className="sr-only"> {score.dit}</span>
+        </span>
+      )}
+      <Icon name="chevron-right" />
+    </a>
+  )
+}
+
+function PanneauDuJour({ partie }: { partie: PartieDuJour | null }) {
+  // Sa place gardée pendant qu'il arrive : rien ne saute sous le pouce.
+  if (!partie || partie.etat === 'aucun') return <div className="jd-attente" aria-busy="true" />
+  const salle = [
+    partie.joueurs > 0 ? `Déjà ${partie.joueurs} joueur${partie.joueurs > 1 ? 's' : ''} aujourd’hui` : '',
+    partie.etat !== 'finie' && partie.vainqueursDHier.length > 0 ? ontGagneHier(partie) : '',
+  ]
+    .filter(Boolean)
+    .join(' · ')
+  if (partie.etat === 'finie') {
+    const place = placeDuJour(partie.rang, partie.joueurs, partie.points)
+    return (
+      <>
+        <Chiffre
+          n={partie.points}
+          haut={`points${place ? ` · ${dUnBloc(place)}` : ''}`}
+          bas={`${place ? 'pour l’instant · ' : ''}${nBonnes(partie.justes)}${partie.serie > 1 ? ` · série de ${partie.serie} jours` : ''}`}
+        />
+        {salle && <LaSalle href="/jour#classement" avant={<Icon name="users" />} texte={salle} />}
+        <a className="btn btn-accent btn-block" href="/jour#classement">
+          Voir le classement du jour
+        </a>
+      </>
+    )
+  }
+  return (
+    <>
+      {partie.serie >= 2 ? (
+        <Chiffre n={partie.serie} haut="jours de série" bas={partie.serieTenue ? 'tenue aujourd’hui' : 'joue avant minuit pour la garder'} />
+      ) : (
+        <Chiffre n={partie.total} haut="questions, les mêmes pour tous" bas="un classement chaque jour" />
+      )}
+      {salle && <LaSalle href="/jour#classement" avant={<Icon name="users" />} texte={salle} />}
+      <a className="btn btn-primary btn-block" href="/jour">
+        <Icon name="play" />
+        {partie.etat === 'en-cours' ? `Reprendre · ${pts(partie.points)}` : 'Jouer le quiz du jour'}
+      </a>
+    </>
+  )
+}
+
+function PanneauDuDefi({ defi }: { defi: DefiDeLaSemaine | null }) {
+  if (!defi) return <div className="jd-attente" aria-busy="true" />
+  const { t, sienne, etat } = sonDefi(defi)
+  const n = defi.joueurs
+  const tete = laTete(defi)
+  const salle = tete && (
+    <LaSalle
+      href={PAGE_DU_DEFI}
+      avant={
+        <span className="jd-avatars">
+          {tete.lignes.slice(0, 3).map(l => (
+            <Avatar key={l.profileId} className="jd-avatar" avatar={l.avatar} finition={l.finition} legendaire={l.legendaire} eclat={l.eclat} bordure={l.bordure} />
+          ))}
+        </span>
+      }
+      texte={tete.texte}
+      score={{ n: tete.justes, dit: `avec ${nBonnes(tete.justes)}` }}
+    />
+  )
+  if (etat === 'releve') {
+    const place = sienne && placeDuJour(sienne.rang, n, sienne.justes)
+    return (
+      <>
+        <Chiffre n={t!.justes} haut={`${bonnes(t!.justes)}${place ? ` · ${dUnBloc(place)}` : ''}`} bas="classement figé dimanche à minuit" />
+        {salle}
+        <a className="btn btn-accent btn-block" href={PAGE_DU_DEFI}>
+          Voir le classement du défi
+        </a>
+      </>
+    )
+  }
+  return (
+    <>
+      {etat === 'a-finir' ? (
+        <Chiffre n={t!.justes} haut={`${bonnes(t!.justes)} · ${t!.vies} vie${t!.vies > 1 ? 's' : ''}`} bas={`ton défi t’attend · ${cloture(defi.minutesRestantes)}`} />
+      ) : (
+        <Chiffre n={n} haut={n > 1 ? 'joueurs l’ont relevé' : n === 1 ? 'joueur l’a relevé' : 'joueur : à toi d’ouvrir le bal'} bas={cloture(defi.minutesRestantes)} />
+      )}
+      {salle}
+      <a className="btn btn-primary btn-block" href={PAGE_DU_DEFI}>
+        <Icon name="play" />
+        {etat === 'a-finir' ? 'Reprendre mon défi' : 'Relever le défi'}
+      </a>
+    </>
+  )
+}
