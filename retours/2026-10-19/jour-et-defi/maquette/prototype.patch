+.jd-hud > span { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
+.jd-hud-haut { color: var(--ink); font-size: 0.95rem; font-weight: 600; line-height: 1.25; }
+.jd-hud-bas { color: var(--muted); font-size: 0.85rem; line-height: 1.3; }
+/* Où en est la salle : une ligne en creux, qui ouvre le classement. */
+.jd-salle {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  min-height: 44px;
+  padding: 6px 10px 6px 12px;
+  border-radius: var(--radius-xs);
+  background: var(--surface);
+  color: var(--muted);
+  font-size: 0.88rem;
+  line-height: 1.3;
+  text-decoration: none;
+}
+.jd-salle:hover { color: var(--ink); }
+.jd-salle > .icon { flex: none; width: 18px; height: 18px; color: var(--accent-text); }
+.jd-salle > .icon:last-child { width: 16px; height: 16px; color: var(--muted); }
+.jd-salle-texte { flex: 1; min-width: 0; }
+.jd-salle-score { flex: none; font-family: var(--serif); font-size: 1.5rem; font-weight: 600; line-height: 1; color: var(--accent-text); font-variant-numeric: lining-nums tabular-nums; }
+.jd-avatars { display: inline-flex; flex: none; }
+.jd-avatar { font-size: 1.35rem; line-height: 1; }
+.jd-avatar + .jd-avatar { margin-left: -6px; }
+.jd-attente { min-height: 170px; }
