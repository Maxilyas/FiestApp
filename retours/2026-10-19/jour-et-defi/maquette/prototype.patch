index 74777a5..8e7e10a 100644
--- a/client/src/styles.css
+++ b/client/src/styles.css
@@ -7804,6 +7804,82 @@ body.avec-menu .toast:not(.player-shell > .toast) { bottom: calc(80px + env(safe
   white-space: nowrap;
 }
 
+/* ── La maquette du 19 octobre 2026 : le quiz du jour et le défi de la
+   semaine au même endroit de l'accueil, en onglets (`JourEtDefi`) ───────
+   Le point d'or d'un onglet dit ce qui l'attend derrière, sans compte —
+   l'or de la pastille « À jouer », pas le rouge des défis reçus. */
+.onglet-point { flex: none; width: 7px; height: 7px; border-radius: 50%; background: var(--accent); }
+/* La tuile : deux onglets fins posés sur elle, la tuile d'aujourd'hui dessous. */
+.jour-defi-tuile { border: 1px solid var(--edge); border-radius: var(--radius); background: var(--surface); overflow: hidden; }
+.jour-defi-tuile .onglets-fins { padding: 0 10px; }
+.jour-defi-tuile .onglets-fins .onglet { min-height: 42px; }
+.jour-defi-tuile .gros-bouton { border: 0; border-radius: 0; background: none; }
+/* Le classeur : deux onglets qui tiennent à la carte. Celui qu'on regarde est
+   de la même étoffe qu'elle, opaque, et couvre son trait du haut ; l'autre
+   reste en retrait, le trait passe dessous. */
+.onglets.onglets-classeur { flex-wrap: nowrap; gap: 6px; padding: 0 8px; border: 0; border-radius: 0; background: none; }
+.onglets-classeur .onglet {
+  position: relative;
+  min-height: 44px;
+  margin-bottom: -1px;
+  border: 1px solid var(--edge);
+  border-bottom-color: transparent;
+  border-radius: var(--radius-sm) var(--radius-sm) 0 0;
+  background: var(--surface-faint);
+  color: var(--muted);
+}
+.onglets-classeur .onglet.actif {
+  z-index: 1;
+  border-color: var(--edge-strong) var(--edge-strong) var(--bg-raised);
+  background: var(--bg-raised);
+  color: var(--accent-text);
+  box-shadow: none;
+  font-weight: 600;
+}
+/* Les deux panneaux dans la même case, l'autre caché : le bloc garde la
+   hauteur du plus grand, rien ne saute dessous quand on change d'onglet. */
+.jour-defi-panneaux { display: grid; }
+.jour-defi-panneaux > .jour-defi-panneau { grid-area: 1 / 1; }
+.jour-defi-panneaux > [aria-hidden='true'] { visibility: hidden; }
+.jour-defi-tuile .jour-defi-panneau { display: flex; }
+.jour-defi-carte .jour-defi-panneaux {
+  border: 1px solid var(--edge-strong);
+  border-radius: var(--radius);
+  background: var(--bg-raised);
+}
+.jour-defi-carte .jour-defi-panneau { display: flex; flex-direction: column; gap: 12px; padding: 14px 16px 16px; }
