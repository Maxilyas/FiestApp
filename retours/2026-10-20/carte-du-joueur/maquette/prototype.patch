+                    <span>
+                      {carte.ceSoir.rang > 0 ? (
+                        <>
+                          <b>{place(carte.ceSoir.rang)}</b> ce soir, sur {carte.ceSoir.joueurs} · {pts(carte.ceSoir.points)}
+                        </>
+                      ) : (
+                        'Pas encore de points ce soir'
+                      )}
+                      {carte.ceSoir.reponses > 0 && <span className="c3-soir-detail">{reponsesParType(carte.ceSoir)}</span>}
+                    </span>
+                  </p>
+                )}
+                {p && p.vitrine.length > 0 && (
+                  <ul className="carte-beaux c3-pouvoirs" aria-label="Ses plus beaux hauts faits">
+                    {p.vitrine.map(b => (
+                      <li key={b.key}>
+                        <span className="c3-pouvoir-emoji" aria-hidden="true">
+                          {b.emoji}
+                        </span>
+                        <span className="c3-pouvoir-corps">
+                          <span className="c3-pouvoir-titre">
