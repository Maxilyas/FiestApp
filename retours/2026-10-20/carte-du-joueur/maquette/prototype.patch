+                      <Avatar className="c3-avatar-av" avatar={carte.avatar} finition={carte.finition} eclat={carte.eclat} legendaire={carte.legendaire} bordure={carte.bordure} grand />
+                    </button>
+                    {c && <span className="c3-plaque">{c.nom}{c.amitie && <span className="c3-plaque-amitie">{c.amitie}</span>}</span>}
+                  </div>
+                  {p?.compagnon && c && code && (
+                    <button type="button" className="carte-compagnon c3-perche" onClick={ouvrirCompagnon} aria-label={`Voir ${c.nom} en grand`} title={`${c.nom} · ${c.sorte}`}>
+                      <code.NicheEnMiniature niche={p.compagnon} taille={54} />
+                    </button>
+                  )}
+                </div>
+                {carte.ceSoir && (
+                  <p className="c3-soir">
