+/** Un cadran du dos : son nom, son icône s'il vient d'ailleurs que des soirées, son chiffre et sur combien il porte. */
+interface CadranDuDos {
+  nom: string
+  icone?: ReactNode
+  valeur: string
+  base?: string
+}
+
+/**
+ * Le dos de la carte à collectionner (la proposition 3 de la maquette) : un
+ * seul tableau de ses chiffres — ceux des soirées, puis ses prix, son quiz du
+ * jour, ses duels et sa campagne, qui étaient des pastilles (le propriétaire,
+ * le 20 octobre 2026 : « pas très jolies, limite plus dans le tableau avec les
+ * précisions ») —, ses écussons, et sa collection de légendaires tout au bout.
+ */
+function DosDeLaCarte({ p, avecDessins, glossaire }: { p: NonNullable<CarteDeJoueur['profil']>; avecDessins: { legendaires: boolean; divins: boolean }; glossaire: ReactNode }) {
+  const medaillons = [...(avecDessins.divins ? (p.divins ?? []) : []), ...(avecDessins.legendaires ? p.legendaires : [])]
+  // Les pastilles d'aujourd'hui, en cadrans : chacun garde l'icône de sa pastille. Rien pour ce qu'il n'a jamais fait.
+  const ailleurs: CadranDuDos[] = [
+    ...(p.prix && p.prix.eus > 0 ? [{ nom: 'Prix', icone: <Icon name="award" />, valeur: formatNumber(p.prix.eus), base: `sur ${formatNumber(p.prix.total)}` }] : []),
+    ...(p.jour
+      ? [{ nom: 'Quiz du jour', icone: <Flamme />, valeur: `${formatNumber(p.jour.joues)} j`, base: p.jour.victoires > 0 ? `${p.jour.victoires} victoire${p.jour.victoires > 1 ? 's' : ''}` : undefined }]
+      : []),
+    ...(p.duels ? [{ nom: 'Duels', icone: <BlasonDeLigue ligue={p.duels.ligue} taille={14} decoratif />, valeur: formatNumber(p.duels.cote), base: ligueParCle(p.duels.ligue).nom }] : []),
+    // Sa campagne, quand ses cadrans sont ceux des soirées : sinon, ils la tiennent déjà.
+    ...(p.campagne && p.fiche.soirees > 0 ? [{ nom: 'Campagne', icone: <Icon name="target" />, valeur: formatNumber(p.campagne.record), base: 'record en série' }] : []),
+  ]
+  const cases: CadranDuDos[] = [...cadransDeLaCarte(p).map(([nom, valeur, base]) => ({ nom, valeur, base })), ...ailleurs]
+  return (
+    <>
+      <dl className="admin-cadrans carte-cadrans c3-cadrans">
+        {cases.map(c => (
+          <div key={c.nom} className="admin-cadran carte-cadran">
+            <dt className="admin-cadran-nom">{c.nom}</dt>
+            <dd className="admin-cadran-chiffre num">
+              {c.icone}
+              {c.valeur}
+            </dd>
+            {c.base && <dd className="carte-cadran-base">{c.base}</dd>}
+          </div>
+        ))}
+      </dl>
+      {p.ecussons && p.ecussons.length > 0 && (
+        <div className="c3-rangee">
+          <span className="label">Ses écussons</span>
+          <div className="ecussons" aria-label="Écussons de savoir">
+            {p.ecussons.map(e => (
+              <Ecusson key={e.categorie} categorie={e.categorie} palier={e.palier} />
+            ))}
+          </div>
+        </div>
+      )}
+      {medaillons.length > 0 && (
+        <div className="c3-rangee">
+          <span className="label">Sa collection</span>
+          <div className="carte-legendaires" aria-label="Avatars légendaires">
+            {medaillons.map(cle => (
+              <span key={cle} className="carte-legendaire" title={divin(cle)?.nom ?? legendaire(cle)?.nom}>
+                <Dessin cle={cle} />
+              </span>
+            ))}
+          </div>
+        </div>
+      )}
+      {glossaire}
+    </>
+  )
+}
