@@ -0,0 +1,327 @@
+import { useEffect, useRef, useState, type PointerEvent, type ReactNode, type RefObject } from 'react'
+import type { CarteDeJoueur } from '../../../shared/carte'
+import { compagnonDe, formeDansLaNiche, nomDeLaForme, type CompagnonPossede } from '../../../shared/compagnons'
+import { titreDeLAmitie } from '../../../shared/ornements'
+import { ceQuIlAFallu } from '../../../shared/hautsfaits'
+import { nomDuTitre } from '../../../shared/sentiers'
+import { espacesFines, place, pts, reponsesParType } from '../format'
+import { useALaDemande } from '../aLaDemande'
+import { laNiche } from './NicheHost'
+import { Avatar } from './Avatar'
+import { Icon } from './Icon'
+
+// La maquette de la carte du joueur (le 20 octobre 2026) : « le compagnon
+// apparaît en dessous de l'avatar et ça fait tout descendre » (le
+// propriétaire). Trois propositions, de la plus sobre à la plus créative,
+// derrière un drapeau du téléphone (`quizz.maquette`) ; sans lui, la carte
+// d'aujourd'hui. `retours/2026-10-20/carte-du-joueur/`.
+
+export type MaquetteDeLaCarte = 'vis-a-vis' | 'perche' | 'a-collectionner'
+
+export function maquetteDeLaCarte(): MaquetteDeLaCarte | null {
+  try {
+    const m = localStorage.getItem('quizz.maquette')
+    return m === 'vis-a-vis' || m === 'perche' || m === 'a-collectionner' ? m : null
+  } catch {
+    return null
+  }
+}
+
+/** Ce que la carte dit de lui : son nom, ou celui de sa forme ; ce qu'il est ; sa forme ; le titre de leur amitié. */
+function leCompagnon(compagnon: CompagnonPossede) {
+  const forme = formeDansLaNiche(compagnon)
+  if (!forme) return null
+  return {
+    nom: compagnon.nom ?? forme.nom,
+    sorte: compagnon.nom ? forme.nom : compagnonDe(forme).nom,
+    etape: nomDeLaForme(forme),
+    amitie: titreDeLAmitie(compagnon.paliers),
+  }
+}
+
+/** Le code de la niche, que la carte attend déjà avant de s'ouvrir (`laNiche`). */
+function useNiche() {
+  const code = useALaDemande(laNiche)
+  return code && code !== 'perdu' ? code : null
+}
+
+/**
+ * Proposition 1, « En vis-à-vis » : le compagnon monte dans la tête de la
+ * carte, en face de l'avatar — le joueur à gauche, lui à droite, qui le
+ * regarde (sa niche le retourne vers la page). Son nom dessous, le titre de
+ * leur amitié en or ; sa forme au toucher, en grand.
+ */
+export function CompagnonEnFace({ compagnon, onOuvrir }: { compagnon: CompagnonPossede; onOuvrir: () => void }) {
+  const code = useNiche()
+  const c = leCompagnon(compagnon)
+  if (!c || !code) return null
+  return (
+    <button type="button" className="carte-compagnon carte-compagnon-en-face" onClick={onOuvrir} aria-label={`Voir ${c.nom} en grand`} title={`${c.nom} · ${c.sorte}`}>
+      <code.NicheEnMiniature niche={compagnon} taille={50} />
+      <b className="carte-compagnon-nom">{c.nom}</b>
+      {c.amitie && <span className="carte-compagnon-amitie">{c.amitie}</span>}
+    </button>
+  )
+}
+
+/**
+ * Proposition 2, « Perché sur la carte » : sa niche se pose sur le bord haut
+ * de la carte, à moitié dehors — comme au coin de chaque page —, et la barre,
+ * qui disait « Carte de joueur », devient sa plaque. Il ne prend plus une
+ * ligne de la carte.
+ */
+export function CompagnonPerche({ compagnon, onOuvrir }: { compagnon: CompagnonPossede; onOuvrir: () => void }) {
+  const code = useNiche()
+  const c = leCompagnon(compagnon)
+  if (!c || !code) return null
+  return (
+    <button type="button" className="carte-compagnon carte-perche" onClick={onOuvrir} aria-label={`Voir ${c.nom} en grand`}>
+      <code.NicheEnMiniature niche={compagnon} taille={56} />
+    </button>
+  )
+}
+
+/** Sa plaque, dans la barre de la carte : son nom, ce qu'il est, le titre de leur amitié. */
+export function PlaqueDuCompagnon({ compagnon }: { compagnon: CompagnonPossede }) {
+  const c = leCompagnon(compagnon)
+  if (!c) return null
+  return (
+    <span className="carte-plaque">
+      <b className="carte-plaque-nom">{c.nom}</b>
+      <span className="carte-plaque-detail">
+        {c.sorte}
+        {c.amitie && (
+          <>
+            {' · '}
+            <span className="carte-compagnon-amitie">{c.amitie}</span>
+          </>
+        )}
+      </span>
+    </span>
+  )
+}
+
+/**
+ * Le compagnon touché, en grand, à la place de ce que la carte raconte —
+ * comme l'avatar (`AvatarEnGrand`) : sa niche, ses ornements, son nom, sa
+ * forme et le titre de leur amitié, que les cartes plus serrées ne disent
+ * plus en entier.
+ */
+export function CompagnonEnGrand({ compagnon, hauteur, onRevenir }: { compagnon: CompagnonPossede; hauteur?: number; onRevenir: () => void }) {
+  const code = useNiche()
+  const c = leCompagnon(compagnon)
+  const bouton = useRef<HTMLButtonElement>(null)
+  useEffect(() => {
+    bouton.current?.focus({ preventScroll: true })
+  }, [code])
+  if (!c || !code) return null
+  return (
+    <div className="carte-loupe" style={hauteur ? { minHeight: hauteur } : undefined}>
+      <button ref={bouton} type="button" className="carte-loupe-bouton carte-loupe-compagnon" aria-label="Revenir à la carte" title="Revenir à la carte" onClick={onRevenir}>
+        <code.NicheEnMiniature niche={compagnon} taille={124} grand />
+      </button>
+      <p className="carte-loupe-legende">
+        <span className="detail-famille muted">{`${c.sorte} · ${c.etape}`}</span>
+        <b className="carte-loupe-nom">{c.nom}</b>
+        {c.amitie && <span className="carte-compagnon-amitie">{c.amitie}</span>}
+      </p>
+      <p className="muted small">Touche-le pour revenir à la carte.</p>
+    </div>
+  )
+}
+
+/**
+ * Proposition 2 : ses plus beaux hauts faits en médailles, côte à côte — ce
+ * qu'il a fallu faire sous la rangée, au toucher. Trois lignes de texte
+ * prenaient la moitié de la carte.
+ */
