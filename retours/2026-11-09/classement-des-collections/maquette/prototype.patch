+                <li key={c}>
+                  <Avatar className="cl-a-gagner-av" avatar="✨" legendaire={c} />
+                  <span className="cl-a-gagner-texte">
+                    <b>
+                      <Pierre gemme={gemmeDe(c)} petite /> {nomDe(c)}
+                    </b>
+                    <span className="muted">{a ? ouIlSeGagne(a, true) : ''}</span>
+                  </span>
+                  <span className="cl-a-gagner-valeur">{`+${valeurDeLaPiece(gemmeDe(c))}`}</span>
+                </li>
+              )
+            })}
+          </ul>
+        </section>
+      ) : (
+        <p className="muted small cl-bataille-note">{`Tu es devant ${lui.nom} au classement : ${formatNumber(valeurDe(MOI))} carats contre ${formatNumber(valeurDe(lui))}.`}</p>
+      )}
+    </Feuille>
+  )
+}
+
+export function Collectionneurs() {
+  const [vitrine, setVitrine] = useState<string | null>(DEPART.vitrine)
+  const [bataille, setBataille] = useState<string | null>(DEPART.bataille)
+  const [record, setRecord] = useState<Axe | null>(DEPART.record)
+  const [amis, setAmis] = useState(DEPART.amis)
+  const places = classer('collection')
+  const [premier, deuxieme, troisieme] = places
+  const cercle = amis ? classer('collection', JOUEURS.filter(j => j.ami)) : places
+  const i = cercle.findIndex(p => p.joueur.moi)
+  // Le podium dit les trois premiers : la liste de tous reprend au quatrième, jusqu'au dixième, puis lui et ses voisins.
+  const liste = amis ? cercle : cercle.slice(3, 10)
+  const autour = !amis && i >= 10 ? cercle.slice(i - 1, i + 2) : []
+  return (
+    <div className="player-shell cl-page">
+      <Sortie vers="Mon profil" href="/profil" />
+      <PieceTete piece="Profil" titre="Les collectionneurs" />
+      <SaPlace places={places} />
+      <div className="cl-podium">
+        <CarteDuPodium place={deuxieme} onOuvrir={setVitrine} />
+        <CarteDuPodium place={premier} premier onOuvrir={setVitrine} />
+        <CarteDuPodium place={troisieme} onOuvrir={setVitrine} />
+      </div>
+      <LesDivins onOuvrir={setVitrine} />
+      <h2 className="label cl-surtitre">Qui a le plus de…</h2>
+      <div className="cl-etagere">
+        {RECORDS.map(a => (
+          <Record key={a} axe={a} onOuvrir={setRecord} />
+        ))}
+      </div>
+      <h2 className="label cl-surtitre">Le classement</h2>
+      <div className="onglets onglets-fins cl-cercle" role="tablist" aria-label="Qui classer">
+        <button type="button" role="tab" aria-selected={!amis} className={'onglet' + (!amis ? ' actif' : '')} onClick={() => setAmis(false)}>
+          {`Tous · ${JOUEURS_CLASSES}`}
+        </button>
+        <button type="button" role="tab" aria-selected={amis} className={'onglet' + (amis ? ' actif' : '')} onClick={() => setAmis(true)}>
+          {`Mes amis · ${JOUEURS.filter(j => j.ami).length}`}
+        </button>
+      </div>
+      <ol className="leaderboard cl-liste" start={amis ? 1 : 4}>
+        {liste.map(p => (
+          <Ligne key={p.joueur.id} place={p} onOuvrir={setVitrine} />
+        ))}
+        {autour.length > 0 && (
+          <>
+            <li className="muted center small cl-ellipse" aria-hidden="true">
+              …
+            </li>
+            {autour.map(p => (
+              <Ligne key={p.joueur.id} place={p} onOuvrir={setVitrine} />
+            ))}
+          </>
+        )}
+      </ol>
+      <p className="muted small cl-legende">Touche un joueur : sa vitrine, et de quoi vous confronter.</p>
+      <LeBareme />
+      {record && !vitrine && !bataille && <FeuilleDuRecord axe={record} onComparer={id => setVitrine(id)} onFermer={() => setRecord(null)} />}
+      {vitrine && !bataille && (
+        <Vitrine
+          lui={joueur(vitrine)}
+          onConfronter={() => {
+            setBataille(vitrine)
+            setVitrine(null)
+          }}
+          onFermer={() => setVitrine(null)}
