+}
+
+interface Manche {
+  nom: string
+  icone: Parameters<typeof Icon>[0]['name']
+  moi: number
+  lui: number
+  divine?: boolean
+}
+
+/**
+ * Les manches : ce qu'on a, puis ce qu'on a fait. Les Divins ouvrent la
+ * bataille dès que l'un des deux en a un — ce que personne n'a ne se compare
+ * pas.
+ */
+function manches(moi: Collectionneur, lui: Collectionneur): Manche[] {
+  const defis = (j: Collectionneur) => j.sceaux.or + j.sceaux.argent + j.sceaux.bronze
+  const divines = divinsDe(moi).length + divinsDe(lui).length > 0
+  return [
+    ...(divines ? [{ nom: 'Divins', icone: 'sparkles' as const, moi: divinsDe(moi).length, lui: divinsDe(lui).length, divine: true }] : []),
+    { nom: 'Avatars', icone: 'image', moi: avatarsDe(moi), lui: avatarsDe(lui) },
+    { nom: 'Légendaires', icone: 'star', moi: moi.legendaires.length, lui: lui.legendaires.length },
+    { nom: 'Maîtres', icone: 'crown', moi: moi.maitres.length, lui: lui.maitres.length },
+    { nom: 'Paliers', icone: 'mountain', moi: moi.paliers, lui: lui.paliers },
+    { nom: 'Défis du Cabinet', icone: 'landmark', moi: defis(moi), lui: defis(lui) },
+    { nom: 'Thèmes', icone: 'palette', moi: moi.themes, lui: lui.themes },
+    { nom: 'Niveau', icone: 'zap', moi: moi.niveau, lui: lui.niveau },
+  ]
+}
+
+/** Une carte de l'arène : petite, la même que celles du podium. */
+function CarteDeLArene({ j }: { j: Collectionneur }) {
+  const p = classer('collection').find(x => x.joueur.id === j.id)!
+  return (
+    <span className={`cl-carte cadre-${j.ligue ?? 'aucune'}` + (divinsDe(j).length > 0 ? ' cl-carte-divine' : '')}>
+      <span className="cl-carte-dedans">
+        <span className="cl-carte-rang" aria-hidden="true">
+          <span>{p.rang}</span>
+        </span>
+        <span className="cl-carte-illu">
+          <SonAvatar j={j} className="cl-carte-av" />
+        </span>
+        <span className="cl-carte-nom">{j.moi ? 'Toi' : j.nom}</span>
+        <span className="cl-carte-valeur">
+          <Pierre gemme="carat" petite />
+          {formatNumber(p.valeur)}
+        </span>
+        <SesDivins j={j} />
+      </span>
+    </span>
+  )
+}
+
+/**
+ * La bataille : les deux cartes face à face, une manche par ligne, la manche
+ * à qui a le plus, le verdict ; puis, s'il est devant au classement, ce qui
+ * manque pour le passer — ses Divins d'abord, dont la descente ne se dit
+ * pas, puis ses maîtres et ses légendaires, et où les gagner.
+ */
+function Bataille({ lui, onFermer }: { lui: Collectionneur; onFermer: () => void }) {
+  const ms = manches(MOI, lui)
+  const miennes = ms.filter(m => m.moi > m.lui).length
+  const siennes = ms.filter(m => m.lui > m.moi).length
+  const nulles = ms.filter(m => m.moi === m.lui)
+  const ecart = valeurDe(lui) - valeurDe(MOI)
+  const sesDivins = divinsDe(lui).filter(c => !divinsDe(MOI).includes(c))
+  const maitres = sesMaitresEnPlus(MOI, lui)
+  const legendaires = lui.legendaires.filter(c => !MOI.legendaires.includes(c))
+  // Une seule pièce qui vaut l'écart à elle seule : on sait par où commencer.
+  const plusBelle = Math.max(0, ...sesDivins.map(() => valeurDeLaPiece('divin')), ...maitres.map(() => 25), ...legendaires.map(c => valeurDeLaPiece(gemmeDe(c))))
+  const suffit = plusBelle > ecart
+  return (
+    <Feuille
+      titre={`Toi contre ${lui.nom}`}
+      onFermer={onFermer}
+      pied={
+        <div className="cl-pied">
+          <button type="button" className="btn">
+            <Icon name="eye" /> Sa carte
+          </button>
+          <button type="button" className="btn btn-primary">
+            <Icon name="swords" /> Défier en duel
+          </button>
+        </div>
+      }
+    >
+      <div className="cl-arene">
+        <CarteDeLArene j={MOI} />
+        <span className="cl-arene-vs" aria-hidden="true">
+          VS
+        </span>
+        <CarteDeLArene j={lui} />
+      </div>
+      <p className={'cl-verdict-bataille' + (miennes > siennes ? ' cl-gagnee' : '')}>
+        <Icon name={miennes > siennes ? 'trophy' : 'flag'} />
+        {miennes > siennes ? `Tu l’emportes, ${miennes} manches à ${siennes}` : miennes < siennes ? `${lui.nom} l’emporte, ${siennes} manches à ${miennes}` : `Égalité, ${miennes} partout`}
+        {nulles.length > 0 && <span>{nulles.length === 1 ? `Une manche nulle : ${nulles[0].nom}` : `${nulles.length} manches nulles`}</span>}
+      </p>
+      <ol className="cl-manches">
+        {ms.map(m => {
+          const issue = m.moi > m.lui ? 'moi' : m.lui > m.moi ? 'lui' : 'nulle'
+          return (
+            <li key={m.nom} className={`cl-manche cl-manche-${issue}` + (m.divine ? ' cl-manche-divine' : '')}>
+              <span className="cl-manche-n cl-manche-gauche">
+                {issue === 'moi' && <Icon name="check" />}
+                {formatNumber(m.moi)}
+              </span>
+              <span className="cl-manche-nom">
+                {m.divine ? <Pierre gemme="divin" /> : <Icon name={m.icone} />}
+                {m.nom}
+              </span>
+              <span className="cl-manche-n cl-manche-droite">
+                {formatNumber(m.lui)}
+                {issue === 'lui' && <Icon name="check" />}
+              </span>
+            </li>
+          )
+        })}
+      </ol>
+      {ecart > 0 ? (
+        <section className="cl-manque">
+          <h3 className="label">{`Pour passer ${lui.nom} au classement`}</h3>
+          <p className="muted small cl-manque-phrase">{`Il te manque ${formatNumber(ecart + 1)} carats${suffit ? ' : une seule de ces pièces suffit.' : '.'}`}</p>
+          <ul className="cl-a-gagner">
+            {sesDivins.map(c => (
+              <li key={c} className="cl-a-gagner-divin">
+                <span className="cl-a-gagner-dv" aria-hidden="true">
+                  <Dessin cle={c} />
+                </span>
