+import type { CSSProperties } from 'react'
+import { Avatar } from '../../components/Avatar'
+import { GrosBouton, MenuBarre } from '../../components/Pieces'
+import { IdentiteLigne } from '../../components/Identite'
+import { Icon } from '../../components/Icon'
+import { gemmeDAvatar } from '../../gemmes'
+import { formatNumber, rang } from '../../format'
+import { Palmares } from './Palmares'
+import { TableauDHonneur } from './TableauDHonneur'
+import { Galerie } from './Galerie'
+import { Collectionneurs } from './Collectionneurs'
+import { JOUEURS_CLASSES, MOI, classer, placeDe, valeurDe, type Axe, type Collectionneur, type Gemme } from './donnees'
+import type { BordureDeLigue } from '../../../../shared/duels'
+import './classement.css'
+
+// La maquette du classement des collections (le 9 novembre 2026) : trois
+// propositions, de la plus sobre à la plus créative, dans le vrai client —
+// ses avatars peints, ses finitions, ses bordures, sa feuille, son menu —,
+// sur des joueurs inventés (`donnees.ts`). `/classement?p=1` (le palmarès),
+// `?p=2` (le tableau d'honneur), `?p=3` (la galerie) ; `?vue=entree`, le
+// profil où l'on y entre. Ce qui s'ouvre au toucher s'ouvre aussi par
+// l'adresse, pour les photos : `&face=hugo`, `&axe=maitres`, `&amis`,
+// `&record=maitres`, `&vitrine=hugo`, `&bataille=hugo`.
+
+const params = new URLSearchParams(window.location.search)
+
+/** Ce que l'adresse ouvre d'emblée. */
+export const DEPART = {
+  proposition: params.get('p') ?? '1',
+  vue: params.get('vue'),
+  face: params.get('face'),
+  axe: (params.get('axe') as Axe | null) ?? null,
+  amis: params.has('amis'),
+  record: (params.get('record') as Axe | null) ?? null,
+  vitrine: params.get('vitrine'),
+  bataille: params.get('bataille'),
+  bareme: params.has('bareme'),
+}
+
+/** Sa bordure de ligue, si ses duels lui en ont donné une : jamais sous un Divin. */
+export const bordureDe = (j: Collectionneur): BordureDeLigue | null => (j.ligue && !j.porte?.startsWith('dv:') ? { ligue: j.ligue, crans: j.crans ?? 0 } : null)
+
+/** Son avatar, tel qu'il le porte. */
+export function SonAvatar({ j, className, grand }: { j: Collectionneur; className?: string; grand?: boolean }) {
+  return <Avatar className={className} avatar={j.avatar} finition={j.finition} legendaire={j.porte} eclat={j.eclat} bordure={bordureDe(j)} grand={grand} />
+}
+
+/** Une gemme, la pierre de l'album : son losange à la couleur de sa rareté. */
+export function Pierre({ gemme, petite }: { gemme: Gemme | 'carat'; petite?: boolean }) {
+  const style = gemme === 'carat' ? ({ '--gemme': 'var(--accent)' } as CSSProperties) : gemmeDAvatar(gemme)
+  // Le Divin, une opale irisée, comme sa gemme dans l'album (`.gemme-divin`).
+  return <i className={'cl-pierre' + (petite ? ' cl-pierre-petite' : '') + (gemme === 'divin' ? ' cl-pierre-divin' : '')} style={style} aria-hidden="true" />
+}
+
+/** « 559 carats » : la valeur et son unité, la pierre devant. */
+export function Carats({ n, seul }: { n: number; seul?: boolean }) {
+  return (
+    <span className="cl-carats">
+      <Pierre gemme="carat" petite />
+      <b>{formatNumber(n)}</b>
+      {!seul && <span>{n >= 2 ? 'carats' : 'carat'}</span>}
+    </span>
+  )
+}
+
+/**
+ * Le profil, tel qu'il s'ouvre (`/profil`) : soi-même en tête, puis ses gros
+ * boutons — et le classement, un de plus, qui dit sa place et sa valeur
+ * avant même qu'on le touche. Le même pour les trois propositions : seul ce
+ * qu'il ouvre change.
+ */
+function EntreeDuProfil({ proposition }: { proposition: string }) {
+  const places = classer('collection')
+  const sienne = placeDe(places, MOI.id)!
+  // Ce que la ligne en tête lit d'un profil : la maquette n'en invente que ce qu'elle montre.
+  const profil = {
+    name: MOI.nom,
+    avatar: MOI.avatar,
+    finition: MOI.finition,
+    legendaire: MOI.porte,
+    niveau: MOI.niveau,
+    requis: 2300,
+    acquis: 1460,
+    laurier: null,
+    eclats: [],
+    bordures: [{ ligue: 'bronze', crans: 12 }, { ligue: 'argent', crans: 12 }, { ligue: 'or', crans: MOI.crans }],
+    bordureChoisie: 'auto',
+    boutique: { confettis: { solde: 1840 } },
+  } as never
+  const titre = proposition === '3' ? 'La galerie' : proposition === '2' || proposition === '4' ? 'Les collectionneurs' : 'Le palmarès'
+  return (
+    <div className="player-shell">
+      <h1 className="sr-only">Mon profil</h1>
+      <IdentiteLigne profil={profil} onCarte={() => {}} />
+      <div className="profil-boutons">
+        <GrosBouton icone={<Icon name="hanger" />} titre="M’habiller" detail="Avatar, titre, vitrine, fond, thème, gerbe" onClick={() => {}} />
+        <GrosBouton icone={<Icon name="award" />} titre="Ma collection" jauge={212 / 561} compte="212 sur 561" detail="Avatars, thèmes, trophées — et où gagner le reste" onClick={() => {}} />
+        <GrosBouton
+          icone={<Icon name="trophy" />}
+          titre={titre}
+          detail={`${rang(sienne.rang ?? JOUEURS_CLASSES)} sur ${JOUEURS_CLASSES} · ta collection vaut ${formatNumber(valeurDe(MOI))} carats`}
+          pastille="Nouveau"
+          href={`/classement?p=${proposition}`}
+        />
+        <GrosBouton icone={<Icon name="book" />} titre="Mes soirées" detail="23 soirées, jouées ou animées" onClick={() => {}} />
+        <GrosBouton icone={<Icon name="bar-chart" />} titre="Ma carrière" detail="Précision 71 % · tes courbes" onClick={() => {}} />
+      </div>
+      <MenuBarre ici="profil" />
+    </div>
+  )
+}
+
+export function ClassementMaquette() {
+  if (DEPART.vue === 'entree') return <EntreeDuProfil proposition={DEPART.proposition} />
+  // La synthèse, choisie d'après les trois (le propriétaire, le même jour : « selon tes recommandations »).
+  if (DEPART.proposition === '4') return <Collectionneurs />
+  if (DEPART.proposition === '3') return <Galerie />
+  if (DEPART.proposition === '2') return <TableauDHonneur />
+  return <Palmares />
+}
+
+/** Ce que la ligne dit à un lecteur d'écran : qui, sa place, ce qu'on classe — et que la toucher compare. */
+export const nomDeLaLigne = (j: Collectionneur, r: number | null, dit: string): string =>
+  j.moi ? `Toi, ${r ? rang(r) : 'pas encore au classement'}, ${dit}` : `${j.nom}, ${r ? rang(r) : 'pas encore au classement'}, ${dit} : comparer vos collections`
