+                <Avatar className="cl-piece-av" avatar="✨" legendaire={c} />
+                <span>{nomDe(c)}</span>
+              </span>
+            ))}
+            {sesMaitres.map(b => (
+              <span key={b} className="cl-piece">
+                <span className="cl-couronne" aria-hidden="true">
+                  <Icon name="crown" />
+                </span>
+                <span>{`Maître · ${branche(b)?.nom ?? b}`}</span>
+              </span>
+            ))}
+          </div>
+        </section>
+      )}
+      {(miennes.length > 0 || mesMaitres.length > 0) && (
+        <section className="cl-manque">
+          <h3 className="label">{`Ce que tu as et pas ${lui.nom}`}</h3>
+          <div className="cl-manque-pieces">
+            {miennes.slice(0, 4).map(c => (
+              <span key={c} className="cl-piece">
+                <Avatar className="cl-piece-av" avatar="✨" legendaire={c} />
+                <span>{nomDe(c)}</span>
+              </span>
+            ))}
+            {mesMaitres.map(b => (
+              <span key={b} className="cl-piece">
+                <span className="cl-couronne" aria-hidden="true">
+                  <Icon name="crown" />
+                </span>
+                <span>{`Maître · ${branche(b)?.nom ?? b}`}</span>
+              </span>
+            ))}
+          </div>
+        </section>
+      )}
+    </Feuille>
+  )
+}
+
+/** Le nom d'une pièce, tel que sa fiche l'écrit : un légendaire, un portrait, une forme de compagnon. */
+export function nomDe(cle: string): string {
+  return legendaire(cle)?.nom ?? portrait(cle)?.nom ?? formeDeCompagnon(cle)?.nom ?? cle
+}
+
+/** Sa gemme dans l'album. */
+export const gemmeDe = (cle: string): Gemme => (avatarDeLAlbum(cle, true)?.rarete ?? 'legendaire') as Gemme
+
+/** Le barème, déplié sous le classement : ce que vaut chaque pièce. */
+export function LeBareme() {
+  return (
+    <details className="cl-bareme" open={DEPART.bareme || undefined}>
+      <summary>Comment se compte la valeur ?</summary>
+      <p className="muted small">Chaque pièce vaut sa gemme, celle de l’album :</p>
+      <ul className="cl-bareme-gemmes">
+        {GEMMES.map(x => (
+          <li key={x}>
+            <Pierre gemme={x} />
+            {/* Abrégée comme sous les gemmes de l'album : « Peu commune » passait sur deux lignes et décalait son chiffre. */}
+            <span aria-label={NOM_DE_LA_GEMME[x]}>{x === 'peucommune' ? 'Peu com.' : NOM_DE_LA_GEMME[x]}</span>
+            <b>{VALEUR_DE_LA_GEMME[x]}</b>
+          </li>
+        ))}
+      </ul>
+      <p className="muted small">
+        {`Un maître de sentier vaut un légendaire (${BAREME.maitre}), un Éclat une rare (${BAREME.eclat}), un sceau du Cabinet ${BAREME.sceau.bronze}, ${BAREME.sceau.argent} ou ${BAREME.sceau.or} selon son métal, une bordure de 1 au bronze à 50 chez les maîtres. Un Divin vaut quatre légendaires — comment il descend ne se dit pas.`}
+      </p>
+    </details>
+  )
+}
+
+export function Palmares() {
+  const [amis, setAmis] = useState(DEPART.amis)
+  const [axe, setAxe] = useState<Axe>(DEPART.axe ?? 'collection')
+  const [face, setFace] = useState<string | null>(DEPART.face)
+  const cercle = amis ? JOUEURS.filter(j => j.ami) : JOUEURS
+  const places = classer(axe, cercle)
+  const i = places.findIndex(p => p.joueur.moi)
+  // Les dix premiers, puis lui et ses deux voisins s'il est plus bas — entre amis, tout le monde.
+  const tete = amis ? places : places.slice(0, 10)
+  const autour = !amis && i >= 10 ? places.slice(i - 1, i + 2) : []
+  return (
+    <div className="player-shell cl-page">
+      <Sortie vers="Mon profil" href="/profil" />
+      <PieceTete piece="Profil" titre="Le palmarès" />
+      <TaPlace places={places} axe={axe} amis={amis} />
+      <div className="onglets onglets-fins cl-cercle" role="tablist" aria-label="Qui classer">
+        <button type="button" role="tab" aria-selected={!amis} className={'onglet' + (!amis ? ' actif' : '')} onClick={() => setAmis(false)}>
+          {`Tous · ${JOUEURS_CLASSES}`}
+        </button>
+        <button type="button" role="tab" aria-selected={amis} className={'onglet' + (amis ? ' actif' : '')} onClick={() => setAmis(true)}>
+          {`Mes amis · ${JOUEURS.filter(j => j.ami).length}`}
+        </button>
+      </div>
+      <div className="onglets onglets-puces cl-puces" role="tablist" aria-label="Ce qu’on classe">
+        {PUCES.map(a => (
+          <button key={a} type="button" role="tab" aria-selected={axe === a} className={'onglet' + (axe === a ? ' actif' : '')} onClick={() => setAxe(a)}>
+            {AXES[a].court}
+          </button>
+        ))}
+      </div>
+      <ol className="leaderboard cl-liste">
+        {tete.map(p => (
+          <Ligne key={p.joueur.id} place={p} axe={axe} onOuvrir={setFace} />
+        ))}
+        {autour.length > 0 && (
+          <>
+            <li className="muted center small cl-ellipse" aria-hidden="true">
+              …
+            </li>
+            {autour.map(p => (
+              <Ligne key={p.joueur.id} place={p} axe={axe} onOuvrir={setFace} />
+            ))}
+          </>
+        )}
+      </ol>
+      <p className="muted small cl-legende">Touche un nom : sa collection en face de la tienne.</p>
+      <LeBareme />
+      {face && <FaceAFace lui={joueur(face)} onFermer={() => setFace(null)} />}
+      <MenuBarre ici="profil" />
+    </div>
+  )
+}
diff --git a/client/src/views/classement/TableauDHonneur.tsx b/client/src/views/classement/TableauDHonneur.tsx
new file mode 100644
index 0000000..4a4d4e5
--- /dev/null
+++ b/client/src/views/classement/TableauDHonneur.tsx
@@ -0,0 +1,316 @@
+import { useState } from 'react'
+import { Feuille, MenuBarre, PieceTete, Sortie } from '../../components/Pieces'
+import { Avatar } from '../../components/Avatar'
+import { Icon } from '../../components/Icon'
+import { formatNumber, rang } from '../../format'
+import { avatarDeLAlbum, ouIlSeGagne } from '../../../../shared/album'
+import { Carats, DEPART, Pierre, SonAvatar, nomDeLaLigne } from './ClassementMaquette'
+import { Couronnes, LeBareme, Medaillons, Sceaux, gemmeDe, nomDe } from './Palmares'
+import {
+  AXES,
+  COULEUR_DE_LA_FAMILLE,
+  FAMILLES,
+  JOUEURS_CLASSES,
+  MOI,
+  NOM_DE_LA_FAMILLE,
+  ceQuIlAEtPasMoi,
+  celuiDevant,
+  classer,
+  joueur,
+  rangDeCollection,
+  sesMaitresEnPlus,
+  valeurDe,
+  valeurDeLaPiece,
+  valeurParFamille,
+  type Axe,
+  type Collectionneur,
+  type Place,
+} from './donnees'
+import { branche } from '../../../../shared/branches'
+
+// Proposition 2 — Le tableau d'honneur. La valeur de sa collection en tête,
+// comme un relevé : son rang de collection (« La vitrine »), ce qui la fait
+// — avatars, trophées, style —, puis les records du serveur, une tuile
+// chacun : qui a le plus de maîtres, de légendaires, de sceaux d'or au
+// Cabinet… et où l'on en est soi-même. Une tuile ouvre son classement ; un
+// joueur, la comparaison — et ce qui manque pour le dépasser, avec où le
+// gagner.
+
+/** Les records du tableau, dans l'ordre où on les cherche. */
+const RECORDS: readonly Axe[] = ['collection', 'maitres', 'legendaires', 'cabinet', 'niveau', 'jour', 'eclats', 'style']
+
+/** Ce que la tuile montre sous le chiffre : ses couronnes, ses sceaux, ses légendaires. */
+function Signe({ axe, j }: { axe: Axe; j: Collectionneur }) {
+  if (axe === 'maitres') return <Couronnes j={j} />
+  if (axe === 'cabinet') return <Sceaux j={j} />
+  if (axe === 'legendaires') return <Medaillons cles={j.legendaires} n={3} />
+  return null
+}
+
+export function Record({ axe, onOuvrir }: { axe: Axe; onOuvrir: (a: Axe) => void }) {
+  const places = classer(axe)
+  const tete = places[0]
+  const sienne = places.find(p => p.joueur.moi)!
+  const a = AXES[axe]
+  const ex = places.filter(p => p.rang === 1).length
+  return (
+    <button type="button" className="cl-record" onClick={() => onOuvrir(axe)} aria-label={`${a.record} : ${tete.joueur.nom}, ${a.dit(tete.joueur)}. Toi : ${sienne.rang ? rang(sienne.rang) : 'pas encore au classement'}`}>
+      <span className="cl-record-titre">{a.record}</span>
+      <span className="cl-record-tete">
+        <SonAvatar j={tete.joueur} className="cl-record-av" />
+        <span className="cl-record-qui">
+          <b>{tete.joueur.nom}</b>
+          {ex > 1 && <span className="muted">{`et ${ex - 1} autre${ex > 2 ? 's' : ''}`}</span>}
+        </span>
+      </span>
+      <span className="cl-record-n">
+        <b>{formatNumber(tete.valeur)}</b>
+        <span>{a.sur ? `sur ${a.sur}` : axe === 'collection' ? 'carats' : axe === 'niveau' ? 'niveau' : a.unite[tete.valeur >= 2 ? 1 : 0]}</span>
+      </span>
+      <Signe axe={axe} j={tete.joueur} />
+      <span className="cl-record-toi">
+        {sienne.rang ? (
+          <>
+            {`Toi : ${formatNumber(sienne.valeur)}`}
+            <span>{rang(sienne.rang)}</span>
+          </>
+        ) : (
+          'Toi : pas encore'
+        )}
+      </span>
+    </button>
+  )
+}
+
+/** La valeur de sa collection, en tête : son nombre, son rang de collection, ce qui la fait. */
+function SaValeur() {
+  const v = valeurDe(MOI)
+  const parFamille = valeurParFamille(MOI)
+  const { rang: r, suivant } = rangDeCollection(v)
+  const places = classer('collection')
+  const sienne = places.find(p => p.joueur.moi)!
+  const part = suivant ? (v - r.depuis) / (suivant.depuis - r.depuis) : 1
+  return (
+    <section className="cl-valeur" aria-label="La valeur de ta collection">
+      <span className="label">Ta collection</span>
+      <div className="cl-valeur-haut">
+        <span className="cl-valeur-n">{formatNumber(v)}</span>
+        <span className="cl-valeur-unite">carats</span>
+        <span className="cl-valeur-rang">
+          <b>{`${rang(sienne.rang!)}`}</b>
+          <span>{`sur ${JOUEURS_CLASSES}`}</span>
+          {MOI.mouvement ? <span className="cl-mouvement monte">{`▲${MOI.mouvement} depuis lundi`}</span> : null}
+        </span>
+      </div>
+      <div className="cl-palier">
+        <span className="cl-palier-nom">
+          <Icon name="landmark" />
+          {r.nom}
+        </span>
+        <span className="jauge-fine cl-palier-jauge" aria-hidden="true">
+          <span style={{ width: `${Math.round(part * 100)}%` }} />
+        </span>
+        {suivant && <span className="cl-palier-suivant">{`${suivant.nom} à ${formatNumber(suivant.depuis)} : encore ${formatNumber(suivant.depuis - v)}`}</span>}
+      </div>
+      <div className="cl-pile" role="img" aria-label={FAMILLES.map(f => `${NOM_DE_LA_FAMILLE[f]} ${parFamille[f]}`).join(', ')}>
+        {FAMILLES.map(f => (
+          <span key={f} style={{ flexGrow: parFamille[f], background: COULEUR_DE_LA_FAMILLE[f] }} />
+        ))}
+      </div>
+      <ul className="cl-pile-legende" aria-hidden="true">
+        {FAMILLES.map(f => (
+          <li key={f}>
+            <i style={{ background: COULEUR_DE_LA_FAMILLE[f] }} />
+            {NOM_DE_LA_FAMILLE[f]} <b>{formatNumber(parFamille[f])}</b>
+          </li>
+        ))}
+      </ul>
+    </section>
+  )
+}
+
+/** Une ligne d'un classement ouvert depuis sa tuile. */
+function LigneDuRecord({ place: p, axe, onComparer }: { place: Place; axe: Axe; onComparer: (id: string) => void }) {
+  const j = p.joueur
+  const a = AXES[axe]
+  return (
+    <li>
+      <button type="button" className={'lb-row lb-ouvrable cl-ligne' + (j.moi ? ' me' : '')} aria-label={nomDeLaLigne(j, p.rang, a.dit(j))} onClick={() => !j.moi && onComparer(j.id)}>
+        <span className={'lb-rank' + (p.rang ? ` rank-${p.rang}` : '')}>{p.rang ?? '–'}</span>
+        <SonAvatar j={j} className="lb-avatar" />
+        <span className="cl-nom">
+          <b>{j.moi ? 'Toi' : j.nom}</b>
+          <span className="cl-detail">
+            <Signe axe={axe} j={j} />
+            {axe === 'collection' && `${j.legendaires.length} légendaires · ${j.maitres.length} maître${j.maitres.length > 1 ? 's' : ''}`}
+            {axe === 'niveau' && `${formatNumber(valeurDe(j))} carats`}
+            {axe === 'jour' && `${j.jour.joues} jours joués`}
+          </span>
+        </span>
+        <span className="cl-score">
+          <span className="lb-score">{formatNumber(p.valeur)}</span>
+          <span className="cl-unite">{a.sur ? `sur ${a.sur}` : axe === 'collection' ? 'carats' : a.unite[p.valeur >= 2 ? 1 : 0]}</span>
+        </span>
+      </button>
+    </li>
+  )
+}
+
+export function FeuilleDuRecord({ axe, onComparer, onFermer }: { axe: Axe; onComparer: (id: string) => void; onFermer: () => void }) {
+  const a = AXES[axe]
+  const places = classer(axe)
+  const sienne = places.find(p => p.joueur.moi)!
+  const devant = celuiDevant(places, MOI.id)
+  return (
+    <Feuille titre={a.record} onFermer={onFermer}>
+      <p className="duels-ta-place cl-record-place">
+        <SonAvatar j={MOI} className="lb-avatar" />
+        <span>
+          <b>{sienne.rang ? `Tu es ${rang(sienne.rang)}` : 'Pas encore au classement'}</b>
+          <span className="muted small">{sienne.rang ? `sur ${JOUEURS_CLASSES} · ${a.dit(MOI)}` : a.premier}</span>
+          {sienne.rang && devant && (
+            <span className="muted small">{`Encore ${formatNumber(devant.manque)} ${a.unite[devant.manque >= 2 ? 1 : 0]} pour passer ${devant.place.joueur.nom}`}</span>
+          )}
+        </span>
+      </p>
+      <ol className="leaderboard cl-liste">
+        {places.map(p => (
+          <LigneDuRecord key={p.joueur.id} place={p} axe={axe} onComparer={onComparer} />
+        ))}
+      </ol>
+      <p className="muted small">Touche un nom : sa collection à côté de la tienne.</p>
+    </Feuille>
+  )
+}
+
+/**
+ * La comparaison : les trois familles en miroir — les miennes à gauche, les
+ * siennes à droite —, l'écart, puis ce qu'il a et que je n'ai pas, chaque
+ * pièce à sa gemme, ce qu'elle vaut et où elle se gagne : de quoi le
+ * dépasser, pas seulement le constater.
+ */
+function Comparaison({ lui, onFermer }: { lui: Collectionneur; onFermer: () => void }) {
+  const moi = valeurParFamille(MOI)
+  const sien = valeurParFamille(lui)
+  const vMoi = valeurDe(MOI)
+  const vLui = valeurDe(lui)
+  const max = Math.max(...FAMILLES.flatMap(f => [moi[f], sien[f]]))
+  const pieces = ceQuIlAEtPasMoi(MOI, lui)
+    .map(c => ({ cle: c, gemme: gemmeDe(c), album: avatarDeLAlbum(c, true) }))
+    .sort((x, y) => valeurDeLaPiece(y.gemme) - valeurDeLaPiece(x.gemme))
+  const maitres = sesMaitresEnPlus(MOI, lui)
+  const ecart = vLui - vMoi
+  return (
+    <Feuille
+      titre={`Toi et ${lui.nom}`}
+      onFermer={onFermer}
+      pied={
+        <div className="cl-pied">
+          <button type="button" className="btn">
+            <Icon name="eye" /> Sa carte
+          </button>
+          <button type="button" className="btn btn-primary">
+            <Icon name="swords" /> Défier
+          </button>
+        </div>
+      }
+    >
+      <div className="cl-miroir-tete">
+        <span className="cl-miroir-qui">
+          <SonAvatar j={MOI} className="player-avatar big" />
+          <Carats n={vMoi} seul />
+        </span>
+        <span className={'cl-ecart' + (ecart > 0 ? '' : ' cl-ecart-devant')}>
+          {ecart > 0 ? `${formatNumber(ecart)} carats d’écart` : ecart < 0 ? `${formatNumber(-ecart)} carats d’avance` : 'à égalité'}
+        </span>
+        <span className="cl-miroir-qui">
+          <SonAvatar j={lui} className="player-avatar big" />
+          <Carats n={vLui} seul />
+        </span>
+      </div>
+      <ul className="cl-miroir">
+        {FAMILLES.map(f => (
+          <li key={f} className={moi[f] > sien[f] ? 'cl-mene-moi' : moi[f] < sien[f] ? 'cl-mene-lui' : 'cl-mene-egal'}>
+            <span className="cl-miroir-n">{formatNumber(moi[f])}</span>
+            <span className="cl-miroir-barre cl-miroir-moi" aria-hidden="true">
+              <span style={{ width: `${(moi[f] / max) * 100}%`, background: COULEUR_DE_LA_FAMILLE[f] }} />
+            </span>
+            <span className="cl-miroir-nom">{NOM_DE_LA_FAMILLE[f]}</span>
+            <span className="cl-miroir-barre cl-miroir-lui" aria-hidden="true">
+              <span style={{ width: `${(sien[f] / max) * 100}%`, background: COULEUR_DE_LA_FAMILLE[f] }} />
+            </span>
+            <span className="cl-miroir-n">{formatNumber(sien[f])}</span>
+          </li>
+        ))}
+      </ul>
+      {(pieces.length > 0 || maitres.length > 0) && (
+        <section className="cl-manque">
+          <h3 className="label">{ecart > 0 ? `Pour passer ${lui.nom}` : `Ce que ${lui.nom} a et pas toi`}</h3>
+          {ecart > 0 && (
+            <p className="muted small cl-manque-phrase">
+              {/* Une pièce qui vaut l'écart à elle seule le dit : on sait par où commencer. */}
+              {`Il te manque ${formatNumber(ecart + 1)} carats${maitres.length > 0 || pieces.some(p => valeurDeLaPiece(p.gemme) > ecart) ? ' : une seule de ces pièces suffit.' : '.'}`}
+            </p>
+          )}
+          <ul className="cl-a-gagner">
+            {maitres.slice(0, 2).map(b => (
+              <li key={b}>
+                <span className="cl-couronne" aria-hidden="true">
+                  <Icon name="crown" />
+                </span>
+                <span className="cl-a-gagner-texte">
+                  <b>{`Maître · ${branche(b)?.nom ?? b}`}</b>
+                  <span className="muted">sur son sentier, au palier de maître</span>
+                </span>
+                <span className="cl-a-gagner-valeur">+25</span>
+              </li>
+            ))}
+            {pieces.slice(0, 3).map(p => (
+              <li key={p.cle}>
+                <Avatar className="cl-a-gagner-av" avatar="✨" legendaire={p.cle} />
+                <span className="cl-a-gagner-texte">
+                  <b>
+                    <Pierre gemme={p.gemme} petite /> {nomDe(p.cle)}
+                  </b>
+                  <span className="muted">{p.album ? ouIlSeGagne(p.album, true) : ''}</span>
+                </span>
+                <span className="cl-a-gagner-valeur">{`+${valeurDeLaPiece(p.gemme)}`}</span>
+              </li>
+            ))}
+          </ul>
+        </section>
+      )}
+    </Feuille>
+  )
+}
+
+export function TableauDHonneur() {
+  const [record, setRecord] = useState<Axe | null>(DEPART.record)
+  const [compare, setCompare] = useState<string | null>(DEPART.face)
+  const places = classer('collection')
+  const i = places.findIndex(p => p.joueur.moi)
+  const voisins = places.slice(Math.max(0, i - 2), i + 2)
+  return (
+    <div className="player-shell cl-page">
+      <Sortie vers="Mon profil" href="/profil" />
+      <PieceTete piece="Profil" titre="Les collectionneurs" />
+      <SaValeur />
+      <h2 className="label cl-surtitre">Les records</h2>
+      <div className="cl-records">
+        {RECORDS.map(a => (
+          <Record key={a} axe={a} onOuvrir={setRecord} />
+        ))}
+      </div>
+      <h2 className="label cl-surtitre">Autour de toi</h2>
+      <ol className="leaderboard cl-liste">
+        {voisins.map(p => (
+          <LigneDuRecord key={p.joueur.id} place={p} axe="collection" onComparer={setCompare} />
+        ))}
+      </ol>
+      <LeBareme />
+      {record && !compare && <FeuilleDuRecord axe={record} onComparer={setCompare} onFermer={() => setRecord(null)} />}
+      {compare && <Comparaison lui={joueur(compare)} onFermer={() => setCompare(null)} />}
+      <MenuBarre ici="profil" />
+    </div>
+  )
+}
diff --git a/client/src/views/classement/classement.css b/client/src/views/classement/classement.css
new file mode 100644
index 0000000..07f5560
--- /dev/null
+++ b/client/src/views/classement/classement.css
@@ -0,0 +1,371 @@
+/* La maquette du classement des collections (le 9 novembre 2026) : ses
+   classes en `cl-`, posées sur celles de l'application — `.lb-row`, les
+   onglets, la feuille. Les jetons du thème partout, sauf sur les cartes de
+   la galerie, nocturnes sous tous les thèmes comme la vraie carte. */
+
+/* ── Les pièces communes ─────────────────────────────── */
+
+.cl-pierre {
+  display: inline-block;
+  flex: none;
+  width: 12px;
+  height: 12px;
+  border-radius: 3px;
+  transform: rotate(45deg);
+  background: linear-gradient(135deg, color-mix(in srgb, var(--gemme) 35%, white), var(--gemme) 55%, color-mix(in srgb, var(--gemme) 60%, black));
+  vertical-align: middle;
+}
+.cl-pierre-petite { width: 8px; height: 8px; border-radius: 2px; }
+
+.cl-carats { display: inline-flex; align-items: center; gap: 6px; }
+.cl-carats b { font-family: var(--serif); font-size: 1.2rem; font-weight: 600; line-height: 1; color: var(--accent-text); font-variant-numeric: lining-nums tabular-nums; }
+.cl-carats > span { font-size: 0.82rem; color: var(--muted); }
+
+.cl-surtitre { display: block; margin: 20px 0 8px; }
+
+.cl-liste { padding: 0; list-style: none; }
+.cl-liste > li { list-style: none; }
+.cl-ellipse { padding: 2px 0; }
+.cl-legende { margin: 10px 0 0; text-align: center; }
+
+.cl-ligne { gap: 10px; }
+.cl-nom { display: flex; flex: 1; flex-direction: column; gap: 3px; min-width: 0; }
+.cl-nom > b { display: flex; align-items: center; gap: 6px; overflow: hidden; font-weight: 600; white-space: nowrap; text-overflow: ellipsis; }
+.cl-detail { display: flex; align-items: center; gap: 6px; overflow: hidden; color: var(--muted); font-size: 0.75rem; white-space: nowrap; }
+.cl-score { display: flex; flex: none; flex-direction: column; align-items: flex-end; gap: 3px; }
+.cl-unite { color: var(--muted); font-size: var(--t-label, 0.6875rem); }
+.cl-mouvement { font-size: var(--t-label, 0.6875rem); font-weight: 600; }
+.cl-mouvement.monte { color: var(--en-ligne); }
+.cl-mouvement.descend { color: var(--muted); }
+
+/* Les douze sentiers : un point chacun, d'or s'il en est maître. */
+.cl-crans { display: inline-grid; grid-template-columns: repeat(12, 6px); gap: 2px; }
+.cl-crans i { width: 6px; height: 6px; border-radius: 50%; background: var(--track); }
+.cl-crans i.cl-cran-plein { background: var(--accent); box-shadow: 0 0 5px rgba(var(--accent-rgb), 0.7); }
+
+/* Les dix cartes du Cabinet, au métal de leur défi. */
+.cl-sceaux { display: inline-flex; gap: 3px; }
+.cl-sceaux i { width: 10px; height: 10px; border-radius: 50%; background: var(--track); }
+.cl-sceaux i.cl-sceau-or { background: radial-gradient(circle at 35% 30%, #fff0bf, #b8892f 70%); }
+.cl-sceaux i.cl-sceau-argent { background: radial-gradient(circle at 35% 30%, #ffffff, #858e98 70%); }
+.cl-sceaux i.cl-sceau-bronze { background: radial-gradient(circle at 35% 30%, #f1c08c, #86501f 70%); }
+
+.cl-medaillons { display: inline-flex; align-items: center; gap: 3px; }
+.cl-medaillon { font-size: 1rem; }
+.cl-plus { margin-left: 2px; color: var(--muted); font-size: 0.72rem; font-weight: 600; }
+
+/* Le palier de maître, quand il n'a pas de dessin : la couronne sur l'émail noir du Soleil noir. */
+.cl-couronne { display: grid; flex: none; place-items: center; width: 2.4rem; height: 2.4rem; border: 2px solid #b8892f; border-radius: 50%; background: radial-gradient(circle at 35% 30%, #2c2438, #07060a 75%); color: #f6dd94; }
+.cl-couronne .icon { width: 18px; height: 18px; }
+
+.cl-pied { display: flex; gap: 8px; }
+.cl-pied .btn { flex: 1; justify-content: center; }
+
+/* Un avatar en grand garde la marge de sa bordure de ligue, qui déborde de lui
+   (`--d: 1.9em`, règle `medaillons.md`) : sans elle, le Fleuron de l'or
+   mordait sur le prénom écrit dessous. */
+.cl-vs-cote > .av,
+.cl-miroir-qui > .av,
+.cl-vitrine-tete > .av,
+.cl-ta-place > .av { margin: 0.45em; }
+
+/* ── Le barème ───────────────────────────────────────── */
+
+.cl-bareme { margin: 16px 0 0; padding: 10px 12px; border: 1px solid var(--edge); border-radius: 12px; background: var(--surface); }
+.cl-bareme summary { min-height: 28px; font-size: 0.86rem; font-weight: 600; cursor: pointer; }
+.cl-bareme p { margin: 6px 0; }
+.cl-bareme-gemmes { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 4px; margin: 8px 0; padding: 0; list-style: none; text-align: center; }
+.cl-bareme-gemmes li { display: flex; flex-direction: column; align-items: center; gap: 5px; color: var(--muted); font-size: var(--t-label, 0.6875rem); }
+.cl-bareme-gemmes li .cl-pierre { margin-top: 3px; }
+.cl-bareme-gemmes b { font-family: var(--serif); font-size: 1.25rem; line-height: 1; color: var(--ink); font-variant-numeric: lining-nums; }
+
+/* ── Proposition 1 : le palmarès ─────────────────────── */
+
+.cl-ta-place { display: flex; align-items: center; gap: 8px; margin: 10px 0; padding: 8px 12px 8px 6px; border: 1px solid var(--edge-strong); border-radius: 16px; background: var(--accent-soft); }
+.cl-ta-place > .av { font-size: 1.6rem; }
+.cl-ta-place-texte { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
+.cl-ta-place-texte > b { font-family: var(--serif); font-size: 1.35rem; line-height: 1.1; font-variant-numeric: lining-nums; }
+.cl-ta-place-suivant { display: inline-flex; align-items: center; gap: 5px; margin-top: 2px; color: var(--accent-text-hover); font-size: 0.78rem; }
+.cl-ta-place-suivant .icon { width: 14px; height: 14px; flex: none; }
+
+.cl-cercle { margin-bottom: 10px; }
+.cl-puces { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
+.cl-puces .onglet { justify-content: center; }
+
+/* Le face-à-face */
+.cl-vs { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 8px; margin: 2px 0 10px; }
+.cl-vs-cote { display: flex; flex-direction: column; align-items: center; gap: 4px; text-align: center; }
+.cl-vs-milieu { color: var(--muted); font-family: var(--serif); font-size: 1.1rem; font-style: italic; }
+.cl-verdict { margin: 0 0 14px; color: var(--accent-text); font-weight: 600; text-align: center; }
+.cl-duel { display: flex; flex-direction: column; gap: 9px; margin: 0; padding: 0; list-style: none; }
+.cl-duel-ligne { display: grid; grid-template-columns: 2.4em minmax(0, 1fr) 2.4em; align-items: end; gap: 8px; }
+.cl-duel-moi,
+.cl-duel-lui { color: var(--muted); font-family: var(--serif); font-size: 1.15rem; font-weight: 600; line-height: 1; font-variant-numeric: lining-nums tabular-nums; }
+.cl-duel-moi { text-align: right; }
+.cl-mene-moi .cl-duel-moi,
+.cl-mene-lui .cl-duel-lui { color: var(--accent-text); }
+.cl-duel-milieu { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
+.cl-duel-nom { color: var(--muted); font-size: 0.75rem; text-align: center; }
+.cl-duel-barres { display: grid; grid-template-columns: 1fr 1fr; gap: 3px; }
+.cl-barre { display: flex; height: 7px; overflow: hidden; border-radius: 4px; background: var(--track); }
+.cl-barre-moi { justify-content: flex-end; }
+.cl-barre > span { display: block; height: 100%; border-radius: 4px; background: color-mix(in srgb, var(--muted) 65%, transparent); }
+.cl-mene-moi .cl-barre-moi > span,
+.cl-mene-lui .cl-barre-lui > span { background: var(--accent); }
+
+.cl-manque { margin-top: 18px; }
+.cl-manque-phrase { margin: 4px 0 0; }
+.cl-manque-pieces { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px 6px; margin-top: 10px; }
+.cl-piece { display: flex; flex-direction: column; align-items: center; gap: 5px; font-size: 0.72rem; line-height: 1.2; text-align: center; }
+.cl-piece-av { font-size: 1.9rem; }
+
+/* ── Proposition 2 : le tableau d'honneur ────────────── */
+
+.cl-valeur { margin: 14px 0 4px; padding: 14px; border: 1px solid var(--edge-strong); border-radius: 18px; background: linear-gradient(160deg, rgba(var(--accent-rgb), 0.16), rgba(var(--accent-rgb), 0.03)); }
+.cl-valeur-haut { display: flex; align-items: baseline; gap: 6px; margin-top: 2px; }
+.cl-valeur-n { color: var(--accent-text); font-family: var(--serif); font-size: 2.9rem; font-weight: 600; line-height: 1; font-variant-numeric: lining-nums; }
+.cl-valeur-unite { color: var(--muted); font-size: 0.9rem; }
+.cl-valeur-rang { display: flex; flex-direction: column; align-items: flex-end; margin-left: auto; text-align: right; }
+.cl-valeur-rang b { font-family: var(--serif); font-size: 1.5rem; line-height: 1; font-variant-numeric: lining-nums; }
+.cl-valeur-rang span { color: var(--muted); font-size: 0.75rem; }
+.cl-valeur-rang .cl-mouvement.monte { color: var(--en-ligne); }
+.cl-palier { display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: center; gap: 4px 10px; margin: 12px 0 14px; }
+.cl-palier-nom { display: inline-flex; align-items: center; gap: 6px; color: var(--accent-text); font-family: var(--serif); font-size: 1.1rem; font-weight: 600; }
+.cl-palier-nom .icon { width: 16px; height: 16px; }
+.cl-palier-suivant { grid-column: 1 / -1; color: var(--muted); font-size: 0.75rem; }
+.cl-pile { display: flex; gap: 2px; height: 10px; overflow: hidden; border-radius: 6px; }
+.cl-pile > span { flex-basis: 0; min-width: 4px; }
+.cl-pile-legende { display: flex; flex-wrap: wrap; gap: 4px 12px; margin: 8px 0 0; padding: 0; list-style: none; color: var(--muted); font-size: 0.75rem; }
+.cl-pile-legende li { display: inline-flex; align-items: center; gap: 5px; }
+.cl-pile-legende i { width: 8px; height: 8px; border-radius: 2px; }
+.cl-pile-legende b { color: var(--ink); font-variant-numeric: lining-nums; }
+
+.cl-records { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
+.cl-record { display: flex; flex-direction: column; align-items: stretch; gap: 6px; min-width: 0; padding: 10px; border: 1px solid var(--edge); border-radius: 14px; background: var(--surface); color: var(--ink); font: inherit; text-align: left; cursor: pointer; }
+.cl-record:hover { border-color: var(--edge-strong); }
+/* Deux lignes gardées à chaque titre : les tuiles d'une rangée gardent leurs chiffres à la même hauteur. */
+.cl-record-titre { min-height: 2.5em; color: var(--muted); font-size: 0.75rem; font-weight: 600; line-height: 1.25; }
+.cl-record-tete { display: flex; align-items: center; gap: 6px; min-width: 0; }
+.cl-record-tete > .av { margin: 0.3em 0.45em; font-size: 1.25rem; }
+.cl-record-qui { display: flex; flex-direction: column; min-width: 0; line-height: 1.15; }
+.cl-record-qui b { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
+.cl-record-qui span { font-size: 0.7rem; }
+.cl-record-n { display: flex; align-items: baseline; gap: 5px; }
+.cl-record-n b { color: var(--accent-text); font-family: var(--serif); font-size: 1.7rem; font-weight: 600; line-height: 1; font-variant-numeric: lining-nums; }
+.cl-record-n span { color: var(--muted); font-size: 0.75rem; }
+.cl-record-toi { display: flex; justify-content: space-between; margin-top: auto; padding-top: 6px; border-top: 1px solid var(--edge); color: var(--muted); font-size: 0.75rem; }
+.cl-record-toi span { color: var(--ink); font-weight: 600; }
+.cl-record-place { margin: 0 0 10px; }
+
+/* La comparaison en miroir */
+.cl-miroir-tete { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 8px; margin-bottom: 14px; }
+.cl-miroir-qui { display: flex; flex-direction: column; align-items: center; gap: 6px; }
+.cl-ecart { padding: 4px 10px; border-radius: var(--radius-pill); background: var(--accent-soft); color: var(--accent-text-hover); font-size: 0.75rem; font-weight: 600; text-align: center; }
+.cl-miroir { display: flex; flex-direction: column; gap: 10px; margin: 0; padding: 0; list-style: none; }
+.cl-miroir li { display: grid; grid-template-columns: 2.3em minmax(0, 1fr) 4.6em minmax(0, 1fr) 2.3em; align-items: center; gap: 6px; }
+.cl-miroir-n { color: var(--muted); font-family: var(--serif); font-size: 1.05rem; font-weight: 600; font-variant-numeric: lining-nums tabular-nums; }
+.cl-miroir li > .cl-miroir-n:first-child { text-align: right; }
+.cl-mene-moi > .cl-miroir-n:first-child,
+.cl-mene-lui > .cl-miroir-n:last-child { color: var(--ink); }
+.cl-miroir-nom { color: var(--muted); font-size: 0.72rem; text-align: center; }
+.cl-miroir-barre { display: flex; height: 10px; overflow: hidden; border-radius: 5px; background: var(--track); }
+.cl-miroir-moi { justify-content: flex-end; }
+.cl-miroir-barre > span { border-radius: 5px; }
+
+.cl-a-gagner { display: flex; flex-direction: column; gap: 10px; margin: 10px 0 0; padding: 0; list-style: none; }
+.cl-a-gagner li { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 10px; }
+.cl-a-gagner-av { font-size: 1.75rem; }
+.cl-a-gagner-texte { display: flex; flex-direction: column; gap: 2px; min-width: 0; font-size: 0.75rem; line-height: 1.25; }
+.cl-a-gagner-texte b { display: inline-flex; align-items: center; gap: 6px; color: var(--ink); font-size: 0.86rem; }
+.cl-a-gagner-valeur { color: var(--accent-text); font-family: var(--serif); font-size: 1.15rem; font-weight: 600; font-variant-numeric: lining-nums; }
+
+/* ── Proposition 3 : la galerie ──────────────────────── */
+
+/* Une carte du mur, au cadre de sa ligue (`.cadre-<ligue>`, la vraie carte) ; sans ligue, le champagne de tous. */
+.cl-carte {
+  --cadre-de-tous: linear-gradient(135deg, #f6e3b4 0%, #a9884f 30%, #efd9a2 55%, #7f6236 80%, #e8d1a0 100%);
+  position: relative;
+  display: block;
+  width: 100%;
+  min-width: 0;
+  padding: 3px;
+  border: 0;
+  border-radius: 14px;
+  background: var(--cadre, var(--cadre-de-tous));
+  color: #f3ece2;
+  font: inherit;
+  cursor: pointer;
+  box-shadow: 0 6px 16px rgba(0, 0, 0, 0.35);
+}
+.cl-carte-dedans {
+  position: relative;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 3px;
+  padding: 14px 4px 8px;
+  border-radius: 11px;
+  background:
+    linear-gradient(rgba(255, 255, 255, 0.045) 1px, transparent 1px) 0 0 / 12px 12px,
+    linear-gradient(90deg, rgba(255, 255, 255, 0.045) 1px, transparent 1px) 0 0 / 12px 12px,
+    radial-gradient(circle at 50% 32%, #3a2c22, #140e0c 78%);
+}
+/* Le rang et le blason passent devant l'illustration : la lumière d'une finition, les ailes d'un portrait les couvraient. */
+.cl-carte-rang { position: absolute; z-index: 2; top: 5px; left: 5px; display: grid; place-items: center; width: 24px; height: 24px; }
+.cl-carte-rang::before { position: absolute; inset: 3px; border: 1px solid rgba(255, 255, 255, 0.5); border-radius: 4px; background: var(--cadre, var(--cadre-de-tous)); content: ''; transform: rotate(45deg); }
+.cl-carte-rang span { position: relative; color: var(--gemme-encre, #2a1d0c); font-family: var(--serif); font-size: 0.82rem; font-weight: 700; line-height: 1; font-variant-numeric: lining-nums; }
+.cl-carte-blason { position: absolute; z-index: 2; top: 6px; right: 6px; }
+.cl-carte-illu { display: grid; place-items: center; height: 3.4rem; }
+.cl-carte-av { font-size: 2.1rem; }
+.cl-carte-nom { max-width: 100%; overflow: hidden; font-size: 0.8rem; font-weight: 600; white-space: nowrap; text-overflow: ellipsis; }
+.cl-carte-valeur { display: inline-flex; align-items: center; gap: 5px; color: #f6dd94; font-family: var(--serif); font-size: 1rem; font-weight: 600; line-height: 1; font-variant-numeric: lining-nums; }
+.cl-carte-valeur .cl-pierre { --gemme: #d9b56a !important; }
+.cl-carte-moi { outline: 2px solid var(--accent); outline-offset: 2px; }
+.cl-carte-moi .cl-carte-nom { color: #f6dd94; }
+
+.cl-podium { display: grid; grid-template-columns: 1fr 1.18fr 1fr; align-items: end; gap: 8px; margin: 18px 0 4px; }
+.cl-carte-podium .cl-carte-illu { height: 4.3rem; }
+.cl-carte-podium .cl-carte-av { font-size: 2.7rem; }
+.cl-carte-premier .cl-carte-dedans { padding-top: 18px; }
+.cl-carte-premier .cl-carte-illu { height: 5.4rem; }
+.cl-carte-premier .cl-carte-av { font-size: 3.4rem; }
+.cl-carte-premier .cl-carte-valeur { font-size: 1.2rem; }
+.cl-carte-premier .cl-carte-rang { width: 26px; height: 26px; }
+.cl-carte-premier .cl-carte-rang span { font-size: 0.95rem; }
+
+.cl-mur { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px 8px; }
+
+/* La vitrine */
+.cl-vitrine-tete { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 12px; margin-bottom: 14px; }
+.cl-vitrine-tete > span:nth-child(2) { display: flex; flex-direction: column; min-width: 0; }
+.cl-vitrine-valeur { display: flex; flex-direction: column; align-items: flex-end; }
+.cl-vitrine-valeur b { color: var(--accent-text); font-family: var(--serif); font-size: 1.7rem; line-height: 1; font-variant-numeric: lining-nums; }
+.cl-vitrine-valeur span { color: var(--muted); font-size: 0.75rem; }
+.cl-socles { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; margin: 10px 0 18px; }
+.cl-socle { display: flex; flex-direction: column; align-items: center; margin: 0; text-align: center; }
+.cl-socle-piece { display: grid; place-items: center; height: 4.6rem; }
+.cl-socle-av { font-size: 3rem; }
+.cl-socle-pied { width: 78%; height: 12px; margin-top: 2px; border-radius: 50%; background: radial-gradient(ellipse at 50% 35%, color-mix(in srgb, var(--gemme) 70%, white), color-mix(in srgb, var(--gemme) 45%, black) 70%); box-shadow: 0 0 14px color-mix(in srgb, var(--gemme) 55%, transparent); }
+.cl-socle figcaption { display: flex; flex-direction: column; align-items: center; gap: 2px; margin-top: 8px; font-size: 0.7rem; line-height: 1.2; }
+.cl-socle figcaption b { font-size: 0.78rem; }
+.cl-socle figcaption > span { display: inline-flex; align-items: center; gap: 4px; color: var(--muted); }
+.cl-socle-valeur { color: var(--accent-text) !important; font-family: var(--serif); font-size: 0.95rem; font-weight: 600; }
+
+.cl-gemmes { width: 100%; margin: 8px 0 14px; border-collapse: collapse; font-size: 0.75rem; table-layout: fixed; }
+.cl-gemmes th { padding: 4px 2px; color: var(--muted); font-weight: 500; }
+.cl-gemmes thead th { vertical-align: bottom; }
+.cl-gemmes thead th > span { display: block; margin-top: 6px; font-size: var(--t-label, 0.6875rem); }
+.cl-gemmes tbody th { width: 3.8em; text-align: left; }
+.cl-gemmes td { padding: 6px 2px; border-top: 1px solid var(--edge); color: var(--ink); font-family: var(--serif); font-size: 1.05rem; font-weight: 600; text-align: center; font-variant-numeric: lining-nums tabular-nums; }
+.cl-gemmes td.cl-gemme-plus { color: var(--accent-text); }
+.cl-vitrine-trophees { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
+.cl-vitrine-trophees > span { display: flex; flex-direction: column; gap: 6px; }
+
+/* La bataille */
+.cl-arene { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: center; gap: 10px; margin: 4px 0 12px; }
+.cl-arene .cl-carte { justify-self: center; max-width: 124px; cursor: default; }
+.cl-arene .cl-carte-illu { height: 4.4rem; }
+.cl-arene .cl-carte-av { font-size: 2.6rem; }
+.cl-arene-vs { color: var(--accent-text); font-family: var(--serif); font-size: 1.6rem; font-style: italic; font-weight: 700; }
+.cl-verdict-bataille { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 2px 6px; margin: 0 0 12px; padding: 10px; border: 1px solid var(--edge); border-radius: 12px; background: var(--surface); font-weight: 600; text-align: center; }
+.cl-verdict-bataille > span { flex-basis: 100%; color: var(--muted); font-size: 0.8rem; font-weight: 500; }
+.cl-verdict-bataille.cl-gagnee { border-color: var(--edge-strong); background: var(--accent-soft); color: var(--accent-text-hover); }
+.cl-verdict-bataille .icon { width: 18px; height: 18px; }
+.cl-manches { display: flex; flex-direction: column; gap: 6px; margin: 0; padding: 0; list-style: none; }
+.cl-manche { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 8px; }
+.cl-manche-n { display: flex; align-items: center; gap: 6px; min-height: 36px; padding: 0 12px; border: 1px solid var(--edge); border-radius: 10px; background: var(--surface); color: var(--muted); font-family: var(--serif); font-size: 1.15rem; font-weight: 600; font-variant-numeric: lining-nums tabular-nums; }
+.cl-manche-gauche { justify-content: flex-end; }
+.cl-manche-n .icon { width: 15px; height: 15px; color: var(--accent-text); }
+.cl-manche-moi .cl-manche-gauche,
+.cl-manche-lui .cl-manche-droite { border-color: var(--edge-strong); background: var(--accent-soft); color: var(--accent-text-hover); }
+.cl-manche-nom { display: flex; flex-direction: column; align-items: center; gap: 2px; width: 5.6em; color: var(--muted); font-size: 0.7rem; line-height: 1.15; text-align: center; }
+.cl-manche-nom .icon { width: 16px; height: 16px; color: var(--ink); }
+.cl-bataille-note { margin: 12px 0 0; text-align: center; }
+
+/* ── La synthèse : les collectionneurs ───────────────── */
+
+/* L'opale des Divins, celle de leur gemme dans l'album (`.gemme-divin`) :
+   écrite en dur, comme les métaux d'une ligue — aucun thème ne la repeint —,
+   et toujours sur un sol de nuit : pastel sur l'Ivoire, elle ne se lisait
+   plus. */
+.cl-pierre-divin { background: conic-gradient(#f7b8e8, #9fe3ff, #fff1a6, #b9f5c6, #c9b6ff, #f7b8e8); }
+.cl-opale-texte { display: inline-flex; align-items: center; gap: 4px; padding: 1px 7px; border-radius: var(--radius-pill); background: #1b1424; color: #eadfff; box-shadow: inset 0 0 0 1px rgba(201, 182, 255, 0.55); }
+.cl-opale-pastille { display: inline-flex; flex: none; align-items: center; gap: 3px; padding: 1px 7px 1px 3px; border-radius: var(--radius-pill); background: #1b1424; color: #eadfff; font-size: var(--t-label, 0.6875rem); font-weight: 600; box-shadow: inset 0 0 0 1px rgba(201, 182, 255, 0.65), 0 0 8px rgba(201, 182, 255, 0.35); }
+.cl-opale-bijou { display: inline-block; font-size: 1.05rem; }
+/* À cette taille, un Divin tient dans son cadre, comme dans une liste : ni rayons, ni étincelles. */
+.cl-opale-bijou .dv-rayons,
+.cl-opale-bijou .dv-etincelles { display: none; }
+
+/* Sa place, en tête : deux lignes et ce qui la ferait monter. */
+.cl-sa-place { display: flex; align-items: center; gap: 8px; margin: 10px 0 4px; padding: 10px 12px 10px 6px; border: 1px solid var(--edge-strong); border-radius: 16px; background: var(--accent-soft); }
+.cl-sa-place > .av { margin: 0.45em; font-size: 1.6rem; }
+.cl-sa-place-texte { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
+.cl-sa-place-texte > b { display: flex; align-items: baseline; gap: 6px; font-family: var(--serif); font-size: 1.35rem; line-height: 1.1; font-variant-numeric: lining-nums; }
+.cl-sa-place-sur { color: var(--muted); font-family: var(--sans); font-size: 0.82rem; font-weight: 500; }
+.cl-sa-place-valeur { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 12px; }
+.cl-sa-place-palier { display: inline-flex; align-items: center; gap: 5px; color: var(--accent-text); font-family: var(--serif); font-size: 1.05rem; font-weight: 600; }
+.cl-sa-place-palier .icon { width: 14px; height: 14px; }
+
+/* Une carte qui garde un Divin : l'opale autour d'elle, et sa lueur dans l'illustration. */
+.cl-carte-divine { box-shadow: 0 0 0 1px rgba(234, 223, 255, 0.5), 0 0 22px rgba(201, 182, 255, 0.6), 0 6px 16px rgba(0, 0, 0, 0.35); }
+.cl-carte-divine .cl-carte-dedans {
+  background:
+    radial-gradient(circle at 50% 30%, rgba(201, 182, 255, 0.32), transparent 62%),
+    linear-gradient(rgba(255, 255, 255, 0.045) 1px, transparent 1px) 0 0 / 12px 12px,
+    linear-gradient(90deg, rgba(255, 255, 255, 0.045) 1px, transparent 1px) 0 0 / 12px 12px,
+    radial-gradient(circle at 50% 32%, #2f2440, #120d16 78%);
+}
+.cl-carte .cl-opale-pastille { margin-top: 4px; }
+
+/* Une ligne qui garde un Divin : un filet d'opale. */
+.lb-row.cl-ligne-divine { box-shadow: inset 0 0 0 1px rgba(201, 182, 255, 0.6), 0 0 16px rgba(201, 182, 255, 0.16); }
+
+/* La salle des Divins : de nuit sous tous les thèmes, comme la carte. */
+.cl-divins {
+  margin: 20px 0 4px;
+  padding: 14px 12px 12px;
+  border-radius: 18px;
+  background:
+    radial-gradient(ellipse at 50% 0%, rgba(201, 182, 255, 0.24), transparent 62%),
+    radial-gradient(ellipse at 12% 100%, rgba(159, 227, 255, 0.12), transparent 55%),
+    radial-gradient(ellipse at 90% 100%, rgba(247, 184, 232, 0.1), transparent 55%),
+    #140f18;
+  color: #f3ece2;
+  box-shadow: inset 0 0 0 1px rgba(201, 182, 255, 0.45), 0 10px 30px rgba(0, 0, 0, 0.35);
+}
+.cl-divins-tete { display: flex; flex-direction: column; align-items: center; gap: 2px; margin-bottom: 10px; text-align: center; }
+.cl-divins-titre { margin: 0; background: linear-gradient(90deg, #f7b8e8, #9fe3ff 35%, #fff1a6 65%, #b9f5c6); -webkit-background-clip: text; background-clip: text; color: transparent; font-family: var(--serif); font-size: 1.8rem; font-weight: 600; line-height: 1.1; }
+.cl-divins-tete > span { color: #c4b8d2; font-size: 0.75rem; }
+.cl-divins-liste { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px 6px; margin: 0; padding: 0; list-style: none; }
+.cl-divin { display: flex; flex-direction: column; align-items: center; min-width: 0; text-align: center; }
+.cl-divin > button { display: flex; flex-direction: column; align-items: center; gap: 4px; width: 100%; min-height: 44px; padding: 4px 2px; border: 0; border-radius: 12px; background: none; color: inherit; font: inherit; cursor: pointer; }
+.cl-divin-bijou { display: grid; place-items: center; height: 4.4rem; font-size: 3rem; }
+.cl-divin-nom { font-size: 0.75rem; font-weight: 600; line-height: 1.2; }
+.cl-divin-voile { padding-top: 4px; }
+.cl-divin-voile .cl-divin-nom { color: #9d93a8; font-style: italic; font-weight: 500; }
+.cl-divin-porteur { display: inline-flex; align-items: center; gap: 4px; color: #ddd2ea; font-size: 0.72rem; }
+.cl-divin-porteur .av { font-size: 0.95rem; }
+.cl-divins-secret { margin: 10px 0 0; color: #b3a6c2; font-family: var(--serif); font-size: 1rem; font-style: italic; text-align: center; }
+
+/* L'étagère des records, qui glisse de côté dans son cadre, comme celles de la boutique : rien ne déborde de la page. */
+.cl-etagere { display: grid; grid-auto-columns: minmax(138px, 44%); grid-auto-flow: column; gap: 8px; padding: 2px 2px 8px; overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; scrollbar-width: thin; }
+.cl-etagere > .cl-record { scroll-snap-align: start; }
+
+/* La vitrine d'un joueur qui garde un Divin. */
+.cl-vitrine-divine { display: flex; align-items: center; justify-content: center; gap: 10px; margin: -4px 0 14px; padding: 8px 12px; border-radius: 12px; background: radial-gradient(ellipse at 50% 0%, rgba(201, 182, 255, 0.28), transparent 72%), #1b1424; color: #eadfff; font-family: var(--serif); font-size: 1.1rem; font-style: italic; box-shadow: inset 0 0 0 1px rgba(201, 182, 255, 0.5); }
+.cl-socle-dv { display: grid; place-items: center; font-size: 3rem; }
+.cl-socle-divin .cl-socle-pied { background: radial-gradient(ellipse at 50% 35%, #ffffff, rgba(201, 182, 255, 0.95) 35%, rgba(90, 60, 140, 0.85) 72%); box-shadow: 0 0 18px rgba(201, 182, 255, 0.85); }
+.cl-socle-divin figcaption .cl-opale-texte { color: #eadfff; }
+/* Six gemmes : chaque colonne à la largeur de son nom — égales, « Commune » s'y coupait en deux. */
+.cl-gemmes-six { table-layout: auto; }
+.cl-gemmes-six tbody th { width: 2.6em; }
+.cl-gemmes-six thead th > span { white-space: nowrap; }
+
+/* La manche des Divins, en tête de la bataille. */
+.cl-manche-divine .cl-manche-n { box-shadow: inset 0 0 0 1px rgba(201, 182, 255, 0.45); }
+.cl-manche-divine.cl-manche-moi .cl-manche-gauche,
+.cl-manche-divine.cl-manche-lui .cl-manche-droite { border-color: rgba(201, 182, 255, 0.75); background: #1b1424; color: #eadfff; box-shadow: 0 0 12px rgba(201, 182, 255, 0.35); }
+.cl-manche-divine .cl-manche-n .icon { color: #eadfff; }
+.cl-manche-nom .cl-pierre { margin: 2px 0 3px; }
+.cl-a-gagner-dv { display: grid; place-items: center; width: 2.4rem; font-size: 2rem; }
+.cl-a-gagner-divin .cl-opale-texte { align-self: flex-start; font-size: var(--t-label, 0.6875rem); }
