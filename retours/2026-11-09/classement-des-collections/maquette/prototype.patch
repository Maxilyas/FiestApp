+export const MOI = JOUEURS.find(j => j.moi)!
+
+// ── La valeur ─────────────────────────────────────────────────────────────
+
+export type Famille = 'avatars' | 'trophees' | 'style'
+
+export const FAMILLES: readonly Famille[] = ['avatars', 'trophees', 'style']
+
+export const NOM_DE_LA_FAMILLE: Readonly<Record<Famille, string>> = { avatars: 'Avatars', trophees: 'Trophées', style: 'Style' }
+
+/** Les trois familles de « Ma collection », chacune sa couleur sur la barre de la valeur — l'or, le bleu, le lilas : elles diffèrent aussi en clarté. */
+export const COULEUR_DE_LA_FAMILLE: Readonly<Record<Famille, string>> = { avatars: '#f2b84b', trophees: '#5fa8ff', style: '#b77bff' }
+
+const somme = (xs: readonly number[]) => xs.reduce((s, x) => s + x, 0)
+
+/** Ses bordures : une par ligue atteinte, jusqu'à la sienne. */
+const liguesAtteintes = (j: Collectionneur): CleDeLigue[] => (j.ligue ? ORDRE_DES_LIGUES.slice(0, ORDRE_DES_LIGUES.indexOf(j.ligue) + 1) : [])
+
+/** Ce que vaut chacune de ses trois familles, en carats. */
+export function valeurParFamille(j: Collectionneur): Record<Famille, number> {
+  const gemmes = gemmesDe(j)
+  const avatars = somme(GEMMES.map(x => gemmes[x] * VALEUR_DE_LA_GEMME[x])) + j.eclats * BAREME.eclat
+  const trophees =
+    j.maitres.length * BAREME.maitre +
+    j.sceaux.or * BAREME.sceau.or +
+    j.sceaux.argent * BAREME.sceau.argent +
+    j.sceaux.bronze * BAREME.sceau.bronze +
+    j.trophees * BAREME.trophee +
+    j.timbres * BAREME.timbre
+  const style =
+    j.themes * BAREME.theme + j.fonds * BAREME.fond + j.gerbes * BAREME.gerbe + j.finitions * BAREME.finition + somme(liguesAtteintes(j).map(l => BAREME.ligue[l]))
+  return { avatars, trophees, style }
+}
+
+export const valeurDe = (j: Collectionneur): number => somme(Object.values(valeurParFamille(j)))
+
+/** Combien d'avatars de l'album il a, toutes gemmes, ses Divins compris. */
+export const avatarsDe = (j: Collectionneur): number => somme(Object.values(gemmesDe(j)))
+
+/** Ce que ses Divins pèsent dans sa valeur. */
+export const valeurDesDivins = (j: Collectionneur): number => divinsDe(j).length * VALEUR_DE_LA_GEMME.divin
+
+/** Ce que sa pièce vaut, pour la vitrine : sa gemme, et une rare de plus si elle a éclaté. */
+export const valeurDeLaPiece = (gemme: Gemme, eclat?: unknown): number => VALEUR_DE_LA_GEMME[gemme] + (eclat ? BAREME.eclat : 0)
+
+// ── Les axes du classement ────────────────────────────────────────────────
+
+export type Axe = 'collection' | 'niveau' | 'maitres' | 'legendaires' | 'cabinet' | 'style' | 'eclats' | 'jour' | 'timbres'
+
+export interface DefinitionDUnAxe {
+  nom: string
+  /** Le nom d'une puce, court. */
+  court: string
+  /** « Le plus de maîtres » : le titre de son record. */
+  record: string
+  valeur: (j: Collectionneur) => number
+  /** L'ordre des ex æquo, à l'affichage seulement : ils partagent leur rang (invariant 15). */
+  ensuite?: (j: Collectionneur) => number
+  /** « 9 sur 12 », « niv. 47 », « 1678 ». */
+  dit: (j: Collectionneur) => string
+  /** L'unité, au singulier et au pluriel, pour une phrase. */
+  unite: [string, string]
+  sur?: number
+  /** Ce qui, à zéro, le fait entrer au classement : l'absence, pas « 87ᵉ avec 0 ». */
+  premier: string
+}
