+const ORDRE_DES_LIGUES: readonly CleDeLigue[] = ['bronze', 'argent', 'or', 'platine', 'diamant', 'maitre']
+
+export interface Collectionneur {
+  id: string
+  nom: string
+  /** L'emoji de son inscription ; `porte`, ce qui le remplace. */
+  avatar: string
+  porte?: string
+  finition?: Finition
+  eclat?: boolean | Matiere
+  /** Sa ligue aux duels : sa bordure, le cadre de sa carte. */
+  ligue?: CleDeLigue
+  crans?: number
+  niveau: number
+  /** Les avatars de l'album qu'il a, gemme par gemme, sans les Divins — sa liste les compte (`gemmesDe`). */
+  gemmes: Readonly<Record<Exclude<Gemme, 'divin'>, number>>
+  /** Ses légendaires (`lg:`) : ce que sa carte montre déjà au dos. */
+  legendaires: readonly string[]
+  /** Ses Divins descendus (`dv:`) : sa carte les montre déjà, tout au bout — jamais comment, ni quand. */
+  divins?: readonly string[]
+  /** Les sentiers dont il a validé le palier de maître. */
+  maitres: readonly CleDeBranche[]
+  /** Ses paliers validés, sur les cent quarante-quatre des douze sentiers — comme la carte (« Paliers 90 sur 144 ») : les maîtres à part. */
+  paliers: number
+  /** Les défis de ses cartes du Cabinet, au rang le plus haut tenu : dix cartes. */
+  sceaux: { or: number; argent: number; bronze: number }
+  /** Ses Éclats, ses autres trophées, ses timbres. */
+  eclats: number
+  trophees: number
+  timbres: number
+  /** Le style : thèmes (35), fonds (25), gerbes (25), finitions (12). */
+  themes: number
+  fonds: number
+  gerbes: number
+  finitions: number
+  /** Le quiz du jour : ses jours joués, ses victoires — sa carte les dit déjà. */
+  jour: { joues: number; victoires: number }
+  /** Ses pièces les plus précieuses, à montrer : un légendaire, une forme ultime. */
+  pieces: readonly { cle: string; eclat?: boolean | Matiere }[]
+  ami?: boolean
+  moi?: boolean
+  /** Ses places gagnées (ou perdues) depuis lundi. */
+  mouvement?: number
+}
