+
+export interface Place {
+  joueur: Collectionneur
+  /** Absent à zéro : qui n'a rien de ce qu'on classe n'est pas classé. */
+  rang: number | null
+  valeur: number
+}
+
+/**
+ * Un classement selon un axe : rang = 1 + ceux strictement devant, les ex
+ * æquo partagent leur place (invariant 15, `shared/classement.ts` dans la
+ * vraie version) ; le départage ne range que l'ordre d'affichage. Les rangs
+ * sont ceux qu'ils auraient parmi les 87.
+ */
+export function classer(axe: Axe, joueurs: readonly Collectionneur[] = JOUEURS): Place[] {
+  const a = AXES[axe]
+  const tries = [...joueurs].sort((x, y) => a.valeur(y) - a.valeur(x) || (a.ensuite ? a.ensuite(y) - a.ensuite(x) : 0) || x.nom.localeCompare(y.nom))
+  return tries.map(j => {
+    const v = a.valeur(j)
+    return { joueur: j, valeur: v, rang: v > 0 ? 1 + tries.filter(o => a.valeur(o) > v).length : null }
+  })
+}
+
+export const placeDe = (places: readonly Place[], id: string): Place | undefined => places.find(p => p.joueur.id === id)
+
+export const joueur = (id: string): Collectionneur => JOUEURS.find(j => j.id === id) ?? JOUEURS[0]
+
+/** Le plus proche devant lui, strictement : celui qu'il passerait. */
+export function celuiDevant(places: readonly Place[], id: string): { place: Place; manque: number } | null {
+  const i = places.findIndex(p => p.joueur.id === id)
+  const sienne = places[i]
+  const devant = places
+    .slice(0, i)
+    .reverse()
+    .find(p => p.valeur > sienne.valeur)
+  return devant ? { place: devant, manque: devant.valeur - sienne.valeur + 1 } : null
+}
+
+// ── Le face-à-face ────────────────────────────────────────────────────────
+
+export interface LigneDuFaceAFace {
+  nom: string
+  moi: number
+  lui: number
+  sur?: number
+}
+
+/** Les lignes qu'on compare, de ce qu'on a à ce qu'on a fait. */
+export function faceAFace(moi: Collectionneur, lui: Collectionneur): LigneDuFaceAFace[] {
+  return [
+    { nom: 'Divins', moi: divinsDe(moi).length, lui: divinsDe(lui).length, sur: 6 },
+    { nom: 'Avatars', moi: avatarsDe(moi), lui: avatarsDe(lui), sur: 173 },
+    { nom: 'Légendaires', moi: moi.legendaires.length, lui: lui.legendaires.length, sur: 32 },
+    { nom: 'Maîtres des sentiers', moi: moi.maitres.length, lui: lui.maitres.length, sur: 12 },
+    { nom: 'Paliers des sentiers', moi: moi.paliers, lui: lui.paliers, sur: 144 },
+    { nom: 'Sceaux d’or du Cabinet', moi: moi.sceaux.or, lui: lui.sceaux.or, sur: 10 },
+    { nom: 'Éclats', moi: moi.eclats, lui: lui.eclats },
+    { nom: 'Thèmes', moi: moi.themes, lui: lui.themes, sur: 35 },
+    { nom: 'Trophées', moi: moi.trophees + moi.maitres.length, lui: lui.trophees + lui.maitres.length, sur: 283 },
+    { nom: 'Niveau', moi: moi.niveau, lui: lui.niveau },
+  ]
+}
+
+/** Qui mène, ligne par ligne : ses lignes, les miennes, les égalités. */
+export function bilanDuFaceAFace(lignes: readonly LigneDuFaceAFace[]): { moi: number; lui: number; egalites: number } {
+  return {
+    moi: lignes.filter(l => l.moi > l.lui).length,
+    lui: lignes.filter(l => l.lui > l.moi).length,
+    egalites: lignes.filter(l => l.lui === l.moi).length,
+  }
+}
+
+/** Ses légendaires que je n'ai pas — ce que j'irais chercher pour le rattraper. Jamais un Divin : rien ne dit comment il descend. */
+export const ceQuIlAEtPasMoi = (moi: Collectionneur, lui: Collectionneur): string[] => lui.legendaires.filter(c => !moi.legendaires.includes(c))
+
+/** Ses maîtres que je n'ai pas. */
+export const sesMaitresEnPlus = (moi: Collectionneur, lui: Collectionneur): CleDeBranche[] => lui.maitres.filter(b => !moi.maitres.includes(b))
+
+// ── Les rangs de collection (la proposition 2) ────────────────────────────
+
+/**
+ * Les rangs d'une collection, nommés d'après ce qu'elle remplit — jamais
+ * d'après celui qui la tient : « La vitrine » se dit de Léa comme de Max, et
+ * aucun nom n'a de genre à accorder.
+ */
+export const RANGS = [
+  { nom: 'Le tiroir', depuis: 0 },
+  { nom: 'Le coffret', depuis: 100 },
+  { nom: 'La vitrine', depuis: 300 },
+  { nom: 'La galerie', depuis: 600 },
+  { nom: 'Le musée', depuis: 1000 },
+  { nom: 'Le palais', depuis: 1500 },
+] as const
+
+export type RangDeCollection = (typeof RANGS)[number]
+
+export function rangDeCollection(valeur: number): { rang: RangDeCollection; suivant?: RangDeCollection } {
+  let i = 0
+  while (i + 1 < RANGS.length && valeur >= RANGS[i + 1].depuis) i++
+  return { rang: RANGS[i], suivant: RANGS[i + 1] }
+}
