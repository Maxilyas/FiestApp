+
+/**
+ * La bataille : les deux cartes face à face, sept manches, la manche à qui a
+ * le plus — rien de tiré au sort, rien qui se rejoue : ce qu'on a gagné en
+ * jouant, mis côte à côte. Le classement dit qui a la plus belle collection ;
+ * la bataille, qui gagne la plupart des manches — on peut être derrière au
+ * classement et l'emporter.
+ */
+function Bataille({ lui, onFermer }: { lui: Collectionneur; onFermer: () => void }) {
+  const ms = manches(MOI, lui)
+  const miennes = ms.filter(m => m.moi > m.lui).length
+  const siennes = ms.filter(m => m.lui > m.moi).length
+  const egales = ms.length - miennes - siennes
+  const places = classer('collection')
+  const [pMoi, pLui] = [places.find(p => p.joueur.moi)!, places.find(p => p.joueur.id === lui.id)!]
+  return (
+    <Feuille
+      titre={`Toi contre ${lui.nom}`}
+      onFermer={onFermer}
+      pied={
+        <div className="cl-pied">
+          <button type="button" className="btn">
+            <Icon name="rotate" /> Revoir
+          </button>
+          <button type="button" className="btn btn-primary">
+            <Icon name="swords" /> Défier en duel
+          </button>
+        </div>
+      }
+    >
+      <div className="cl-arene">
+        <CarteDuMur place={pMoi} onOuvrir={() => {}} />
+        <span className="cl-arene-vs" aria-hidden="true">
+          VS
+        </span>
+        <CarteDuMur place={pLui} onOuvrir={() => {}} />
+      </div>
+      <p className={'cl-verdict-bataille' + (miennes > siennes ? ' cl-gagnee' : '')}>
+        <Icon name={miennes > siennes ? 'trophy' : 'flag'} />
+        {miennes > siennes ? `Tu l’emportes, ${miennes} manches à ${siennes}` : miennes < siennes ? `${lui.nom} l’emporte, ${siennes} manches à ${miennes}` : `Égalité, ${miennes} partout`}
+        {egales > 0 && <span>{egales === 1 ? `Une manche nulle : ${ms.find(m => m.moi === m.lui)!.nom}` : `${egales} manches nulles`}</span>}
+      </p>
+      <ol className="cl-manches">
+        {ms.map(m => {
+          const issue = m.moi > m.lui ? 'moi' : m.lui > m.moi ? 'lui' : 'nulle'
+          return (
+            <li key={m.nom} className={`cl-manche cl-manche-${issue}`}>
+              <span className="cl-manche-n cl-manche-gauche">
+                {issue === 'moi' && <Icon name="check" />}
+                {formatNumber(m.moi)}
+              </span>
+              <span className="cl-manche-nom">
+                <Icon name={m.icone} />
+                {m.nom}
+              </span>
+              <span className="cl-manche-n cl-manche-droite">
+                {formatNumber(m.lui)}
+                {issue === 'lui' && <Icon name="check" />}
+              </span>
+            </li>
+          )
+        })}
+      </ol>
+      {pLui.rang! < pMoi.rang! && miennes > siennes && (
+        <p className="muted small cl-bataille-note">{`${lui.nom} reste devant toi au classement — ${formatNumber(pLui.valeur)} carats contre ${formatNumber(pMoi.valeur)} : ses pièces valent plus, tu en as plus.`}</p>
+      )}
+    </Feuille>
+  )
+}
+
+export function Galerie() {
+  const [vitrine, setVitrine] = useState<string | null>(DEPART.vitrine)
+  const [bataille, setBataille] = useState<string | null>(DEPART.bataille)
+  const places = classer('collection')
+  const [premier, deuxieme, troisieme] = places
+  const mur = places.slice(3)
+  return (
+    <div className="player-shell cl-page">
+      <Sortie vers="Mon profil" href="/profil" />
+      <PieceTete piece="Profil" titre="La galerie">
+        <p className="muted small">Les plus belles collections, en cartes. Touche-en une : sa vitrine.</p>
+      </PieceTete>
+      <div className="cl-podium">
+        <CarteDuMur place={deuxieme} taille="podium" onOuvrir={setVitrine} />
+        <CarteDuMur place={premier} taille="premier" onOuvrir={setVitrine} />
+        <CarteDuMur place={troisieme} taille="podium" onOuvrir={setVitrine} />
+      </div>
+      <h2 className="label cl-surtitre">{`Le mur · ${JOUEURS_CLASSES} collections`}</h2>
+      <div className="cl-mur">
+        {mur.map(p => (
+          <CarteDuMur key={p.joueur.id} place={p} onOuvrir={setVitrine} />
+        ))}
+      </div>
+      <p className="muted small cl-legende">{`… et ${JOUEURS_CLASSES - places.length} autres collections plus bas sur le mur`}</p>
+      <LeBareme />
+      {vitrine && !bataille && (
+        <Vitrine
+          lui={joueur(vitrine)}
+          onConfronter={() => {
+            setBataille(vitrine)
+            setVitrine(null)
+          }}
+          onFermer={() => setVitrine(null)}
+        />
+      )}
+      {bataille && <Bataille lui={joueur(bataille)} onFermer={() => setBataille(null)} />}
+      <MenuBarre ici="profil" />
+    </div>
+  )
+}
