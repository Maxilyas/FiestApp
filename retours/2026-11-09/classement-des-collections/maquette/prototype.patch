+const g = (commune: number, peucommune: number, rare: number, epique: number, legendaire: number): Record<Exclude<Gemme, 'divin'>, number> => ({ commune, peucommune, rare, epique, legendaire })
+
+/** Ses Divins, jamais absents : une liste vide pour qui n'en a pas. */
+export const divinsDe = (j: Collectionneur): readonly string[] => j.divins ?? []
+
+/** Ses avatars de l'album gemme par gemme, ses Divins compris. */
+export const gemmesDe = (j: Collectionneur): Record<Gemme, number> => ({ ...j.gemmes, divin: divinsDe(j).length })
