+import { useState } from 'react'
+import { Feuille, MenuBarre, PieceTete, Sortie } from '../../components/Pieces'
+import { Avatar, Dessin } from '../../components/Avatar'
+import { Icon } from '../../components/Icon'
+import { BlasonDeLigue } from '../../components/Blason'
+import { gemmeDAvatar } from '../../gemmes'
+import { formatNumber, rang } from '../../format'
+import { avatarDeLAlbum, ouIlSeGagne } from '../../../../shared/album'
+import { branche } from '../../../../shared/branches'
+import { DIVINS, divin } from '../../../../shared/divins'
+import { Carats, DEPART, Pierre, SonAvatar, nomDeLaLigne } from './ClassementMaquette'
+import { Couronnes, LeBareme, Sceaux, gemmeDe, nomDe } from './Palmares'
+import { FeuilleDuRecord, Record } from './TableauDHonneur'
+import {
+  GEMMES,
+  JOUEURS,
+  JOUEURS_CLASSES,
+  MOI,
+  NOM_DE_LA_GEMME,
+  avatarsDe,
+  celuiDevant,
+  classer,
+  divinsDe,
+  gemmesDe,
+  joueur,
+  rangDeCollection,
+  sesMaitresEnPlus,
+  valeurDe,
+  valeurDeLaPiece,
+  type Axe,
+  type Collectionneur,
+  type Place,
+} from './donnees'
+
+// La synthèse (le 9 novembre 2026) : « Fais-moi une maquette selon tes
+// recommandations de ce qui rend le mieux » (le propriétaire, sur les trois
+// premières). Une seule page, ce que chacune faisait le mieux :
+//
+// - de la 2, la tête — sa place, sa valeur, son rang de collection — et les
+//   records, ici sur une étagère qui glisse de côté ;
+// - de la 3, le podium en cartes à collectionner, la vitrine d'un joueur et
+//   la bataille des collections ;
+// - de la 1, la liste et « Tous · Mes amis » ;
+// - de la 2 encore, ce qu'il manque pour passer quelqu'un, et où le gagner,
+//   au pied de la bataille.
+//
+// Et les Divins, comptés et mis en avant (« en avoir un devrait être
+// vraiment mis en avant », le même jour) : cent carats chacun, leur propre
+// salle sous le podium — ceux qui sont descendus, peints, et qui les a ; les
+// autres sous leur voile, sans nom —, une opale sur la carte, la ligne et la
+// vitrine de qui en a un. Rien ne dit comment ils descendent, ni quand.
+
+const RECORDS: readonly Axe[] = ['maitres', 'legendaires', 'cabinet', 'niveau', 'jour', 'style', 'eclats']
+
+/** Qui a ce Divin, parmi les joueurs classés. */
+const porteursDe = (cle: string): Collectionneur[] => JOUEURS.filter(j => divinsDe(j).includes(cle))
+
+/** Ses Divins en petit, peints, dans leur pastille d'opale — sur sa carte, sur sa ligne. */
+function SesDivins({ j, avecNombre }: { j: Collectionneur; avecNombre?: boolean }) {
+  const siens = divinsDe(j)
+  if (siens.length === 0) return null
+  return (
+    <span className="cl-opale-pastille" aria-label={`${siens.length} Divin${siens.length > 1 ? 's' : ''} : ${siens.map(c => divin(c)?.nom).join(', ')}`}>
+      {siens.map(c => (
+        <span key={c} className="cl-opale-bijou" aria-hidden="true">
+          <Dessin cle={c} />
+        </span>
+      ))}
+      {avecNombre && <span aria-hidden="true">{`${siens.length} Divin${siens.length > 1 ? 's' : ''}`}</span>}
+    </span>
+  )
+}
+
+/** Sa place, sa valeur, son rang de collection, et qui il passerait — d'un coup d'œil, en tête. */
+function SaPlace({ places }: { places: readonly Place[] }) {
+  const sienne = places.find(p => p.joueur.moi)!
+  const devant = celuiDevant(places, MOI.id)
+  const v = valeurDe(MOI)
+  const { rang: palier, suivant } = rangDeCollection(v)
+  return (
+    <section className="cl-sa-place" aria-label="Ta place">
+      <SonAvatar j={MOI} />
+      <span className="cl-sa-place-texte">
+        <b>
+          {`Tu es ${rang(sienne.rang!)}`}
+          <span className="cl-sa-place-sur">{` sur ${JOUEURS_CLASSES}`}</span>
+          {MOI.mouvement ? <span className="cl-mouvement monte">{`▲${MOI.mouvement}`}</span> : null}
+        </b>
+        <span className="cl-sa-place-valeur">
+          <Carats n={v} />
+          <span className="cl-sa-place-palier">
+            <Icon name="landmark" />
+            {palier.nom}
+          </span>
+        </span>
+        {devant && (
+          <span className="cl-ta-place-suivant">
+            <Icon name="arrow-up" />
+            {`Encore ${formatNumber(devant.manque)} carats pour passer ${devant.place.joueur.nom}`}
+          </span>
+        )}
+        {!devant && suivant && <span className="muted small">{`${suivant.nom} à ${formatNumber(suivant.depuis)}`}</span>}
+      </span>
+    </section>
+  )
+}
+
+/** Une carte du podium : le cadre de sa ligue, son avatar, son rang en gemme, sa valeur — et ses Divins, en opale. */
+function CarteDuPodium({ place: p, premier, onOuvrir }: { place: Place; premier?: boolean; onOuvrir: (id: string) => void }) {
+  const j = p.joueur
+  const divine = divinsDe(j).length > 0
+  return (
+    <button
+      type="button"
+      className={`cl-carte cadre-${j.ligue ?? 'aucune'} cl-carte-podium` + (premier ? ' cl-carte-premier' : '') + (divine ? ' cl-carte-divine' : '')}
+      onClick={() => onOuvrir(j.id)}
+      aria-label={`${j.nom}, ${rang(p.rang!)}, ${formatNumber(p.valeur)} carats${divine ? `, ${divinsDe(j).length} Divin${divinsDe(j).length > 1 ? 's' : ''}` : ''} : sa vitrine`}
+    >
+      <span className="cl-carte-dedans">
+        <span className="cl-carte-rang" aria-hidden="true">
+          <span>{p.rang}</span>
+        </span>
+        {j.ligue && <BlasonDeLigue ligue={j.ligue} taille={16} decoratif className="cl-carte-blason" />}
+        <span className="cl-carte-illu">
+          <SonAvatar j={j} className="cl-carte-av" />
+        </span>
+        <span className="cl-carte-nom">{j.nom}</span>
+        <span className="cl-carte-valeur">
+          <Pierre gemme="carat" petite />
+          {formatNumber(p.valeur)}
+        </span>
+        <SesDivins j={j} />
+      </span>
+    </button>
+  )
+}
+
+/**
+ * La salle des Divins, sous le podium : les six, ceux qui sont descendus
+ * peints — leur nom, qui l'a, ce qu'il vaut —, les autres sous leur voile,
+ * sans nom, comme dans l'album. Toucher un porteur ouvre sa vitrine.
+ */
+function LesDivins({ onOuvrir }: { onOuvrir: (id: string) => void }) {
+  const descendus = DIVINS.filter(d => porteursDe(d.key).length > 0).length
+  return (
+    <section className="cl-divins" aria-labelledby="cl-divins-titre">
+      <header className="cl-divins-tete">
+        <h2 id="cl-divins-titre" className="cl-divins-titre">
+          Les Divins
+        </h2>
+        <span>{`${descendus} descendus sur ${DIVINS.length} · 100 carats chacun`}</span>
+      </header>
+      <ul className="cl-divins-liste">
+        {DIVINS.map(d => {
+          const porteurs = porteursDe(d.key)
+          if (porteurs.length === 0) {
+            return (
+              <li key={d.key} className="cl-divin cl-divin-voile">
+                <span className="cl-divin-bijou" aria-hidden="true">
+                  <Dessin cle={d.key} verrouille />
+                </span>
+                <span className="cl-divin-nom">Pas encore descendu</span>
+              </li>
+            )
+          }
+          const [premier, ...autres] = porteurs
+          return (
+            <li key={d.key} className="cl-divin">
+              <button type="button" onClick={() => onOuvrir(premier.id)} aria-label={`${d.nom} : chez ${porteurs.map(p => p.nom).join(', ')}`}>
+                <span className="cl-divin-bijou" aria-hidden="true">
+                  <Dessin cle={d.key} grand />
+                </span>
+                <span className="cl-divin-nom">{d.nom}</span>
+                <span className="cl-divin-porteur">
+                  <SonAvatar j={premier} className="lb-avatar" />
+                  {premier.moi ? 'Toi' : premier.nom}
+                  {autres.length > 0 && <span className="muted">{` +${autres.length}`}</span>}
+                </span>
+              </button>
+            </li>
+          )
+        })}
+      </ul>
+      <p className="cl-divins-secret">Comment ils descendent ne se dit pas.</p>
+    </section>
+  )
+}
+
+/** Une ligne du classement : sa place, son avatar, ses Divins en opale, ce qu'il a, sa valeur. */
+function Ligne({ place: p, onOuvrir }: { place: Place; onOuvrir: (id: string) => void }) {
+  const j = p.joueur
+  const divine = divinsDe(j).length > 0
+  return (
+    <li>
+      <button
+        type="button"
+        className={'lb-row lb-ouvrable cl-ligne' + (j.moi ? ' me' : '') + (divine ? ' cl-ligne-divine' : '')}
+        aria-label={nomDeLaLigne(j, p.rang, `${formatNumber(p.valeur)} carats`)}
+        onClick={() => onOuvrir(j.id)}
+      >
+        <span className={'lb-rank' + (p.rang ? ` rank-${p.rang}` : '')}>{p.rang}</span>
+        <SonAvatar j={j} className="lb-avatar" />
+        <span className="cl-nom">
+          <b>
+            {j.moi ? 'Toi' : j.nom}
+            {/* Ses Divins à côté du prénom, sur la ligne qu'on lit d'abord : sous lui, ils poussaient ses légendaires hors de la ligne. */}
+            <SesDivins j={j} />
+            {j.mouvement ? (
+              <span className={'cl-mouvement' + (j.mouvement > 0 ? ' monte' : ' descend')} aria-hidden="true">
+                {j.mouvement > 0 ? `▲${j.mouvement}` : `▼${-j.mouvement}`}
+              </span>
+            ) : null}
+          </b>
+          <span className="cl-detail">{`${j.legendaires.length} légendaires · ${j.maitres.length} maître${j.maitres.length > 1 ? 's' : ''}`}</span>
+        </span>
+        <span className="cl-score">
+          <span className="lb-score">{formatNumber(p.valeur)}</span>
+          <span className="cl-unite">carats</span>
+        </span>
+      </button>
+    </li>
+  )
+}
+
+/** Une pièce maîtresse sur son socle : un Divin sur l'opale, rayons compris, les autres à la couleur de leur gemme. */
+function Socle({ cle, eclat }: { cle: string; eclat?: unknown }) {
+  const estDivin = !!divin(cle)
+  const gemme = estDivin ? 'divin' : gemmeDe(cle)
+  return (
+    <figure className={'cl-socle' + (estDivin ? ' cl-socle-divin' : '')} style={gemmeDAvatar(gemme)}>
+      <span className="cl-socle-piece">
+        {estDivin ? (
+          <span className="cl-socle-dv" aria-hidden="true">
+            <Dessin cle={cle} grand />
+          </span>
+        ) : (
+          <Avatar className="cl-socle-av" avatar="✨" legendaire={cle} eclat={eclat ? true : undefined} />
+        )}
+      </span>
+      <span className="cl-socle-pied" aria-hidden="true" />
+      <figcaption>
+        <b>{estDivin ? divin(cle)!.nom : nomDe(cle)}</b>
+        <span className={estDivin ? 'cl-opale-texte' : undefined}>
+          <Pierre gemme={gemme} petite /> {NOM_DE_LA_GEMME[gemme]}
+          {eclat ? ' · éclaté' : ''}
+        </span>
+        <span className="cl-socle-valeur">{`${valeurDeLaPiece(gemme, eclat)} carats`}</span>
+      </figcaption>
+    </figure>
+  )
+}
+
+/** Sa vitrine : ses Divins d'abord, puis ses plus belles pièces ; sa collection gemme par gemme, à côté de la mienne. */
+function Vitrine({ lui, onConfronter, onFermer }: { lui: Collectionneur; onConfronter: () => void; onFermer: () => void }) {
+  const place = classer('collection').find(p => p.joueur.id === lui.id)!
+  const pieces = [...divinsDe(lui).map(cle => ({ cle, eclat: undefined })), ...lui.pieces.filter(p => !divin(p.cle))].slice(0, 3)
+  const siennes = gemmesDe(lui)
+  const miennes = gemmesDe(MOI)
+  return (
+    <Feuille
+      titre={lui.moi ? 'Ta vitrine' : `La vitrine de ${lui.nom}`}
+      onFermer={onFermer}
+      pied={
+        lui.moi ? undefined : (
+          <div className="cl-pied">
+            <button type="button" className="btn">
+              <Icon name="eye" /> Sa carte
+            </button>
+            <button type="button" className="btn btn-primary" onClick={onConfronter}>
+              <Icon name="swords" /> Confronter
+            </button>
+          </div>
+        )
+      }
+    >
+      <div className="cl-vitrine-tete">
+        <SonAvatar j={lui} className="player-avatar big" />
+        <span>
+          <b>{lui.moi ? 'Toi' : lui.nom}</b>
+          <span className="muted small">{`${rang(place.rang!)} sur ${JOUEURS_CLASSES} · niveau ${lui.niveau}`}</span>
+        </span>
+        <span className="cl-vitrine-valeur">
+          <b>{formatNumber(valeurDe(lui))}</b>
+          <span>carats</span>
+        </span>
+      </div>
+      {divinsDe(lui).length > 0 && (
+        <p className="cl-vitrine-divine">
+          <Pierre gemme="divin" />
+          {divinsDe(lui).length > 1
+            ? `${divinsDe(lui).length} Divins veillent sur sa collection`
+            : `Un Divin veille sur sa collection`}
+        </p>
+      )}
