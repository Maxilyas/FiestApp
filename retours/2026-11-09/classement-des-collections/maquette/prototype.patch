+  type Collectionneur,
+  type Gemme,
+  type Place,
+} from './donnees'
+
+// Proposition 1 — Le palmarès (la plus sobre). Le classement des duels, sa
+// feuille et ses lignes, tourné vers la collection : sa place en tête, « Tous »
+// ou « Mes amis », six puces qui changent ce qu'on classe — la valeur de la
+// collection, le niveau, les maîtres des sentiers, les légendaires, le
+// Cabinet, le style —, et chaque ligne qui ouvre le face-à-face : sa
+// collection contre la mienne, ligne à ligne.
+
+const PUCES: readonly Axe[] = ['collection', 'niveau', 'maitres', 'legendaires', 'cabinet', 'style']
+
+/** Les douze sentiers en douze crans : couronné, le sentier dont il est maître. */
+export function Couronnes({ j }: { j: Collectionneur }) {
+  return (
+    <span className="cl-crans" aria-hidden="true">
+      {BRANCHES.map(b => (
+        <i key={b.key} className={j.maitres.includes(b.key) ? 'cl-cran-plein' : undefined} />
+      ))}
+    </span>
+  )
+}
+
+/** Les dix cartes du Cabinet, chacune au métal de son défi le plus haut. */
+export function Sceaux({ j }: { j: Collectionneur }) {
+  const metaux = [...Array(j.sceaux.or).fill('or'), ...Array(j.sceaux.argent).fill('argent'), ...Array(j.sceaux.bronze).fill('bronze')]
+  return (
+    <span className="cl-sceaux" aria-hidden="true">
+      {Array.from({ length: 10 }, (_, i) => (
+        <i key={i} className={metaux[i] ? `cl-sceau-${metaux[i]}` : undefined} />
+      ))}
+    </span>
+  )
+}
+
+/** Ses premiers légendaires, en petit, peints — le reste compté au bout. */
+export function Medaillons({ cles, n = 4 }: { cles: readonly string[]; n?: number }) {
+  return (
+    <span className="cl-medaillons" aria-hidden="true">
+      {cles.slice(0, n).map(c => (
+        <Avatar key={c} className="cl-medaillon" avatar="✨" legendaire={c} />
+      ))}
+      {cles.length > n && <span className="cl-plus">+{cles.length - n}</span>}
+    </span>
+  )
+}
+
+/** Ce que la ligne dit sous le prénom, selon ce qu'on classe. */
+function Detail({ axe, j }: { axe: Axe; j: Collectionneur }) {
+  switch (axe) {
+    case 'collection':
+      return (
+        <span className="cl-detail">
+          {j.legendaires.length} légendaires · {j.maitres.length} maître{j.maitres.length > 1 ? 's' : ''}
+        </span>
+      )
+    case 'niveau':
+      return <span className="cl-detail">{formatNumber(valeurDe(j))} carats</span>
+    case 'maitres':
+      return (
+        <span className="cl-detail">
+          <Couronnes j={j} />
+          <span>{j.paliers}/144</span>
+        </span>
+      )
+    case 'legendaires':
+      return (
+        <span className="cl-detail">
+          <Medaillons cles={j.legendaires} />
+        </span>
+      )
+    case 'cabinet':
+      return (
+        <span className="cl-detail">
+          <Sceaux j={j} />
+        </span>
+      )
+    default:
+      return (
+        <span className="cl-detail">
+          {j.fonds} fonds · {j.gerbes} gerbes
+        </span>
+      )
+  }
+}
+
+/** Le nombre au bout de la ligne, et sous lui son unité — « sur 12 » quand il a un plafond. */
+function Score({ axe, j }: { axe: Axe; j: Collectionneur }) {
+  const a = AXES[axe]
+  const v = a.valeur(j)
+  return (
+    <span className="cl-score">
+      <span className="lb-score">{formatNumber(v)}</span>
+      <span className="cl-unite">{a.sur ? `sur ${a.sur}` : axe === 'niveau' ? 'niveau' : a.unite[v >= 2 ? 1 : 0]}</span>
+    </span>
+  )
+}
+
+function Ligne({ place: p, axe, onOuvrir }: { place: Place; axe: Axe; onOuvrir: (id: string) => void }) {
+  const j = p.joueur
+  return (
+    <li>
+      <button type="button" className={'lb-row lb-ouvrable cl-ligne' + (j.moi ? ' me' : '')} aria-label={nomDeLaLigne(j, p.rang, AXES[axe].dit(j))} onClick={() => onOuvrir(j.id)}>
+        <span className={'lb-rank' + (p.rang ? ` rank-${p.rang}` : '')}>{p.rang ?? '–'}</span>
+        <SonAvatar j={j} className="lb-avatar" />
+        <span className="cl-nom">
+          <b>
+            {j.moi ? 'Toi' : j.nom}
+            {j.mouvement ? (
+              <span className={'cl-mouvement' + (j.mouvement > 0 ? ' monte' : ' descend')} aria-hidden="true">
+                {j.mouvement > 0 ? `▲${j.mouvement}` : `▼${-j.mouvement}`}
+              </span>
+            ) : null}
+          </b>
+          <Detail axe={axe} j={j} />
+        </span>
+        <Score axe={axe} j={j} />
+      </button>
+    </li>
+  )
+}
+
+/** Sa place en tête : c'est ce qu'on vient chercher, et à soixante lignes de là on ne la trouvait pas (la feuille des duels). */
+function TaPlace({ places, axe, amis }: { places: readonly Place[]; axe: Axe; amis: boolean }) {
+  const sienne = places.find(p => p.joueur.moi)!
+  const a = AXES[axe]
+  const devant = celuiDevant(places, MOI.id)
+  return (
+    <section className="cl-ta-place" aria-label="Ta place">
+      <SonAvatar j={MOI} />
+      <span className="cl-ta-place-texte">
+        {sienne.rang ? (
+          <>
+            <b>{`Tu es ${rang(sienne.rang)}`}</b>
+            <span className="muted small">{`sur ${amis ? places.length : JOUEURS_CLASSES} · ${a.dit(MOI)}`}</span>
+          </>
+        ) : (
+          <>
+            <b>Pas encore au classement</b>
+            <span className="muted small">{a.premier}</span>
+          </>
+        )}
+        {sienne.rang && devant && (
+          <span className="cl-ta-place-suivant">
+            <Icon name="arrow-up" />
+            {`Encore ${formatNumber(devant.manque)} ${a.unite[devant.manque >= 2 ? 1 : 0]} pour passer ${devant.place.joueur.nom}`}
+          </span>
+        )}
+      </span>
+    </section>
+  )
+}
+
+/**
+ * Le face-à-face : sa collection contre la mienne, ligne à ligne — la barre de
+ * chacun, l'or à qui mène —, puis ce qu'il a que je n'ai pas : ce que
+ * j'irais chercher pour le rattraper. Sa carte et « Défier » au pied, comme
+ * ses gestes partout ailleurs.
+ */
+export function FaceAFace({ lui, onFermer }: { lui: Collectionneur; onFermer: () => void }) {
+  // Ce que ni l'un ni l'autre n'a ne se compare pas : « 0 contre 0 » au Cabinet ne disait rien de personne.
+  const lignes = faceAFace(MOI, lui).filter(l => l.moi > 0 || l.lui > 0)
+  const bilan = bilanDuFaceAFace(lignes)
+  const sesPieces = ceQuIlAEtPasMoi(MOI, lui)
+  const miennes = ceQuIlAEtPasMoi(lui, MOI)
+  const sesMaitres = sesMaitresEnPlus(MOI, lui)
+  const mesMaitres = sesMaitresEnPlus(lui, MOI)
+  const verdict =
+    bilan.lui === bilan.moi
+      ? `À égalité : ${bilan.moi} lignes chacun`
+      : bilan.lui > bilan.moi
+        ? `${lui.nom} mène sur ${bilan.lui} lignes, toi sur ${bilan.moi}`
+        : `Tu mènes sur ${bilan.moi} lignes, ${lui.nom} sur ${bilan.lui}`
+  return (
+    <Feuille
+      titre={`Toi et ${lui.nom}`}
+      onFermer={onFermer}
+      pied={
+        <div className="cl-pied">
+          <button type="button" className="btn">
+            <Icon name="eye" /> Sa carte
+          </button>
+          <button type="button" className="btn btn-primary">
+            <Icon name="swords" /> Défier
+          </button>
+        </div>
+      }
+    >
+      <div className="cl-vs">
+        <div className="cl-vs-cote">
+          <SonAvatar j={MOI} className="player-avatar big" />
+          <b>Toi</b>
+          <Carats n={valeurDe(MOI)} />
+        </div>
+        <span className="cl-vs-milieu" aria-hidden="true">
+          contre
+        </span>
+        <div className="cl-vs-cote">
+          <SonAvatar j={lui} className="player-avatar big" />
+          <b>{lui.nom}</b>
+          <Carats n={valeurDe(lui)} />
+        </div>
+      </div>
+      <p className="cl-verdict">
+        {verdict}
+        {bilan.egalites > 0 && ` · ${bilan.egalites === 1 ? 'une égalité' : `${bilan.egalites} égalités`}`}
+      </p>
+      <ul className="cl-duel">
+        {lignes.map(l => {
+          const max = Math.max(l.moi, l.lui, 1)
+          const mene = l.moi > l.lui ? 'moi' : l.lui > l.moi ? 'lui' : 'egal'
+          return (
+            <li key={l.nom} className={`cl-duel-ligne cl-mene-${mene}`}>
+              <span className="cl-duel-moi">{formatNumber(l.moi)}</span>
+              <span className="cl-duel-milieu">
