+          </tr>
+          {!lui.moi && (
+            <tr>
+              <th scope="row">Toi</th>
+              {GEMMES.map(x => (
+                <td key={x} className={miennes[x] > siennes[x] ? 'cl-gemme-plus' : undefined}>
