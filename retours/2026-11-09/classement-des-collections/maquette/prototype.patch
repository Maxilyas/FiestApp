+/** Une carte du mur : petite, au cadre de sa ligue — sans duel classé, le champagne de tous, comme la vraie. */
+function CarteDuMur({ place: p, taille, onOuvrir }: { place: Place; taille?: 'podium' | 'premier'; onOuvrir: (id: string) => void }) {
