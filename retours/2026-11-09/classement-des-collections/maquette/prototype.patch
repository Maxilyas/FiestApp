+import { avatarDeLAlbum } from '../../../../shared/album'
+import { BRANCHES, branche, portrait } from '../../../../shared/branches'
+import { legendaire } from '../../../../shared/legendaires'
+import { formeDeCompagnon } from '../../../../shared/compagnons'
+import { Carats, DEPART, Pierre, SonAvatar, nomDeLaLigne } from './ClassementMaquette'
+import {
+  AXES,
+  BAREME,
+  GEMMES,
+  JOUEURS,
+  JOUEURS_CLASSES,
+  MOI,
+  NOM_DE_LA_GEMME,
