+// Maquette — le classement des collections (le 9 novembre 2026).
+//
+// « On regarde souvent le classement des joueurs et ce qu'ils ont dans leur
+// collection […] un classement en fonction de leur progression mais aussi de
+// la collection […] savoir si on a une meilleure collection qu'eux, qui a le
+// plus de maîtres dans le sentier, le Cabinet […] Donner une valeur à la
+// collection » (le propriétaire). Rien ici n'est lu du serveur : des joueurs
+// inventés, à l'échelle de la production du début novembre, dont les avatars,
+// les finitions et les bordures sont les vrais dessins de l'application.
+// Léa est « toi », l'habituée des maquettes de la carte : niveau 23, le
+// Phénix, maîtresse des mythologies et du grand écran.
+//
+// La valeur se compte d'un seul barème pour les trois propositions — la
+// gemme de chaque pièce, celle que l'album lui donne déjà —, pour qu'on
+// compare leur façon de la montrer, pas trois règles.
+//
+// Les Divins comptent, et se montrent (le choix du propriétaire, le même
+// jour, sur les trois premières maquettes : « j'aimerais que les Divins
+// soient comptabilisés aussi, c'est uniquement la condition d'obtention qui
+// ne doit pas être dévoilée, mais justement en avoir un devrait être
+// vraiment mis en avant ») : la plus haute gemme, cent carats. La carte d'un
+// joueur montre déjà quels Divins il a ; rien ici ne dit comment ils
+// descendent, ni quand — ni jauge, ni progression, ni date, ni récit
+// (invariant 21, que la vraie version réécrira pour le compte).
+
+import type { Finition } from '../../../../shared/profil'
+import type { CleDeLigue } from '../../../../shared/duels'
+import type { CleDeBranche } from '../../../../shared/branches'
+import type { Matiere } from '../../../../shared/matieres'
+import { formatNumber } from '../../format'
+
+/** Les gemmes de l'album, les Divins au bout. */
+export type Gemme = 'commune' | 'peucommune' | 'rare' | 'epique' | 'legendaire' | 'divin'
+
+export const GEMMES: readonly Gemme[] = ['commune', 'peucommune', 'rare', 'epique', 'legendaire', 'divin']
+
+/**
+ * Le barème : chaque pièce vaut sa gemme. Les rangs de l'album, déjà vus de
+ * tous — commune, peu commune, rare, épique, légendaire, Divin —, plutôt
+ * qu'une échelle de plus à apprendre. Des carats : un mot à elle, ni les
+ * points d'un quiz ni les confettis qu'on dépense — une collection ne se
+ * vend pas. Un Divin vaut quatre légendaires : six en tout, et il fait
+ * changer de place.
+ */
+export const VALEUR_DE_LA_GEMME: Readonly<Record<Gemme, number>> = { commune: 1, peucommune: 2, rare: 5, epique: 10, legendaire: 25, divin: 100 }
+
+/** Le reste se range sur la même échelle. */
+export const BAREME = {
+  /** La version rare d'un avatar : une rare de plus. */
+  eclat: 5,
+  /** Un palier de maître : ce qu'il coûte vaut un légendaire. */
+  maitre: 25,
+  /** Les sceaux des défis du Cabinet, au métal de leur rang. */
+  sceau: { or: 10, argent: 5, bronze: 2 },
+  /** Un autre trophée — une étape de piste, un exploit, un prix —, un timbre du carnet des fêtes. */
+  trophee: 2,
+  timbre: 2,
+  /** Un thème, à sa gemme ; la maquette prend leur moyenne. */
+  theme: 5,
+  fond: 3,
+  gerbe: 3,
+  finition: 2,
+  /** Une bordure par ligue atteinte, à sa hauteur. */
+  ligue: { bronze: 1, argent: 2, or: 5, platine: 10, diamant: 25, maitre: 50 } as Record<CleDeLigue, number>,
+} as const
+
+export const NOM_DE_LA_GEMME: Readonly<Record<Gemme, string>> = {
+  commune: 'Commune',
+  peucommune: 'Peu commune',
+  rare: 'Rare',
