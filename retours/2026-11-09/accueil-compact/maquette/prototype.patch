+
+/* ── Maquette : l'accueil compact (`retours/2026-11-09/accueil-compact/`) ──
+   Tout ce qu'on vient y faire sur un écran, sans défiler (« j'aimerais que
+   tout soit visible sans avoir à scroll plus bas », le propriétaire, le
+   9 novembre 2026) — et sans rien changer au style : la ligne de soi, « À la
+   une », les missions, des boutons à pastille ronde et titre en serif. Seules
+   leurs mesures et leur place changent. Trois pas de hauteur : le petit
+   téléphone (640), un écran moyen (720 et plus), un grand (820 et plus), qui
+   reprend le haut d'aujourd'hui. Derrière le drapeau du téléphone
+   (`quizz.maquette` : `lignes`, `tuiles`). */
+.accueil.maq {
+  /* La hauteur d'une rangée, d'une tuile, d'un bouton « Entre amis » : leur minimum — elles grandissent ensemble. */
+  --maq-rang: 48px;
+  --maq-tuile: 70px;
+  --maq-ami: 50px;
+  --maq-icone: 32px;
+  --maq-titre: 1.12rem;
+  --maq-detail: 0.75rem;
+  --maq-ecart: 10px;
+  --maq-serre: 6px;
+  /* Au-delà, les rangées seraient plus hautes que les gros boutons d'aujourd'hui : la page s'arrête là, le fond continue. */
+  --maq-plafond: 800px;
+  gap: var(--maq-ecart);
+}
+.accueil.maq-tuiles { --maq-plafond: 744px; }
+/* La page prend la hauteur de l'écran, au-dessus de la barre du menu — `min-height: 100dvh`, sous le retrait que la
+   barre pose sur le corps, la faisait toujours défiler de la hauteur de la barre —, et ses rangées se partagent ce
+   qui reste : chacune part de son minimum et grandit avec les autres. Ce qui s'ajoute — une soirée où revenir, la
+   ligne du lendemain, l'application à installer — les resserre d'abord ; la page ne défile que si leur minimum même
+   ne tient plus. */
+body.avec-menu .accueil.maq {
+  min-height: min(calc(100vh - 72px - env(safe-area-inset-bottom)), var(--maq-plafond));
+  min-height: min(calc(100svh - 72px - env(safe-area-inset-bottom)), var(--maq-plafond));
+  padding-bottom: 6px;
+}
+.accueil.maq > * { flex: none; }
+.accueil.maq > .accueil-gestes { flex: 1 0 auto; gap: var(--maq-ecart); }
+.accueil.maq .accueil-gestes > * { flex: none; }
+.accueil.maq .accueil-gestes > .jouer-section { flex: var(--maq-part, 1) 0 auto; gap: var(--maq-serre); }
+.accueil.maq .jouer-section > * { flex: none; }
+/* Ses lignes sous la page : l'application à installer, à la hauteur d'une rangée. */
+.accueil.maq > .installer { padding-block: 0; }
+.accueil.maq > .installer .installer-tete { min-height: 42px; }
+.accueil.maq > .installer .installer-icone { width: 26px; height: 26px; }
+
+/* Un bouton, resserré : sa pastille ronde, son titre d'un cran dessous, une seule ligne sous lui. */
+.accueil.maq .gros-bouton { gap: 10px; min-height: var(--maq-rang); padding: 5px 12px; }
+.accueil.maq .gros-icone { width: var(--maq-icone); height: var(--maq-icone); }
+.accueil.maq .gros-icone .icon { width: calc(var(--maq-icone) * 0.56); height: calc(var(--maq-icone) * 0.56); }
+.accueil.maq .gros-bouton .gros-texte { gap: 0; }
+.accueil.maq .gros-bouton .gros-texte b { font-size: var(--maq-titre); line-height: 1.12; }
+.accueil.maq .gros-detail { overflow: hidden; font-size: var(--maq-detail); line-height: 1.25; white-space: nowrap; text-overflow: ellipsis; }
+.accueil.maq .gros-bouton .chevron { width: 16px; height: 16px; }
+
+/* Proposition 1 — les lignes : une seule carte par section, ses boutons dedans, un filet entre eux. Le cadre de la
+   tuile à onglets (`.jour-defi`), étendu à toute la section. */
+.maq-carte { display: flex; flex-direction: column; border: 1px solid var(--edge); border-radius: var(--radius); background: var(--surface); }
+.accueil.maq .jouer-section > .maq-carte { flex: 1 0 auto; }
+.maq-carte > .gros-bouton { flex: 1 0 auto; border: 0; border-radius: 0; background: none; }
+.maq-carte > .gros-bouton + .gros-bouton { border-top: 1px solid var(--edge); }
+.maq-carte > .gros-bouton:first-child { border-radius: var(--radius) var(--radius) 0 0; }
+.maq-carte > .gros-bouton:last-child { border-radius: 0 0 var(--radius) var(--radius); }
+/* Allumée, la ligne garde son or ; son halo, lui, mordrait sur ses voisines. */
+.maq-carte > .gros-bouton.gros-allume { background: rgba(var(--accent-rgb), 0.1); animation: none; }
+/* Son compteur rouge se pose sur l'épaule de la pastille, comme celui de « Profil » dans le menu : au coin, il passerait sur la ligne du dessus. */
+.maq-carte .gros-compteur { top: calc(50% - var(--maq-icone) / 2 - 6px); right: auto; left: calc(12px + var(--maq-icone) - 15px); box-shadow: 0 0 0 2px var(--surface); }
+
+/* Proposition 2 — les tuiles : deux par rangée. La pastille ronde et le titre sur une ligne, ce qui s'y passe dessous,
+   sur toute la largeur ; ce qui attend (« À jouer ») à cheval sur le bord du haut, comme le compteur rouge sur le coin. */
+.maq-grille { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: 1fr; gap: 8px; }
+.accueil.maq .jouer-section > .maq-grille { flex: 1 0 auto; }
+/* La campagne garde sa rangée, en tête ; les tuiles prennent la part de leurs rangées, plus hautes qu'elle. */
+.maq-tuiles .jouer-section > .gros-bouton { flex: 1 0 auto; }
+.maq-tuiles .jouer-section > .maq-grille:not(.maq-amis) { flex-grow: var(--maq-part-des-tuiles, 2.7); }
+/* La pastille à cheval dépasse de neuf pixels : la rangée du dessus — la campagne, une autre tuile — lui en laisse douze. */
+.maq-tuiles .jouer-section > .maq-grille:not(.maq-amis) { row-gap: 12px; margin-top: calc(12px - var(--maq-serre)); }
+/* Une tuile seule sur sa rangée — cinq modes, un de fermé — la prend entière. */
+.maq-grille > :last-child:nth-child(odd) { grid-column: 1 / -1; }
+.accueil.maq .maq-grille > .gros-bouton {
+  /* Une tuile est étroite : sa pastille ronde et son titre se règlent sur la largeur de l'écran, pas sur sa hauteur.
+     Réglés sur la hauteur, « Le Cabinet de curiosités » passait sur trois lignes en 360 × 740. */
+  --maq-icone: 32px;
+  display: grid;
+  grid-template-columns: auto minmax(0, 1fr);
+  align-content: center;
+  align-items: center;
+  column-gap: 8px;
+  row-gap: 3px;
+  min-height: var(--maq-tuile);
+  padding: 8px 10px;
+}
+.maq-grille > .gros-bouton > .gros-texte { display: contents; }
+.accueil.maq .maq-grille > .gros-bouton .gros-texte b { grid-area: 1 / 2; font-size: 1.12rem; }
+@media (min-width: 384px) {
+  .accueil.maq .maq-grille > .gros-bouton { --maq-icone: 36px; }
+  .accueil.maq .maq-grille > .gros-bouton .gros-texte b { font-size: 1.2rem; }
+}
+.accueil.maq .maq-grille > .gros-bouton .gros-detail { grid-area: 2 / 1 / 3 / 3; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; white-space: normal; }
+.maq-grille > .gros-bouton .chevron { display: none; }
+.maq-grille > .gros-bouton > .pastille-attente { position: absolute; top: -9px; right: 10px; box-shadow: 0 0 0 2px var(--bg); }
+.maq-grille > .gros-bouton > .gros-compteur + .sr-only + .pastille-attente,
+.maq-grille > .gros-bouton:has(.gros-compteur) > .pastille-attente { right: 22px; }
+/* Sous les lignes, « Entre amis » est une carte elle aussi, coupée en deux par un filet : une carte par section. */
+.maq-lignes .maq-amis { gap: 0; border: 1px solid var(--edge); border-radius: var(--radius); background: var(--surface); }
+.accueil.maq-lignes .maq-amis > .gros-bouton { border: 0; border-radius: var(--radius) 0 0 var(--radius); background: none; }
+.accueil.maq-lignes .maq-amis > .gros-bouton + .gros-bouton { border-left: 1px solid var(--edge); border-radius: 0 var(--radius) var(--radius) 0; }
+/* « Entre amis » : deux boutons côte à côte, leur nom seul tant que l'écran est petit. */
+.accueil.maq .maq-amis > .gros-bouton { min-height: var(--maq-ami); padding-block: 5px; }
+.accueil.maq .maq-amis > .gros-bouton .gros-detail { display: none; -webkit-line-clamp: 1; }
+
+/* Le haut — soi, « À la une », les missions —, à trois tailles : serré sur le petit téléphone, moyen, et celui
+   d'aujourd'hui dès que l'écran en a la place. Ses mesures sont des variables : une soirée où revenir, sur un grand
+   écran, le ramène à la taille moyenne plutôt que de pousser « Entre amis » sous le menu. */
+.accueil.maq {
+  --maq-tete: 58px;
+  --maq-tete-ecart: 10px;
+  --maq-avatar: 1.9rem;
+  --maq-nom: 1.3rem;
+  --maq-amis: 38px;
+  /* En `rem`, comme la ligne des missions d'aujourd'hui : au texte agrandi, l'affiche grandit avec ses trois lignes. */
+  --maq-une: 3.375rem;
+  --maq-une-echelle: 0.62;
+  --maq-une-retrait: 68px;
+  --maq-une-nom: 1.12rem;
+  --maq-une-detail: 0.74rem;
+  --maq-une-fleche: none;
+  --maq-missions: 2.75rem;
+  --maq-missions-icone: 30px;
+  --maq-missions-titre: 0.9rem;
+  --maq-missions-detail: 0.74rem;
+}
+/* Soi : la niche du compagnon tient le coin jusqu'à 82 pixels du haut — la ligne s'arrête avec elle. */
+.accueil.maq .accueil-tete { min-height: var(--maq-tete); }
+.accueil.maq .identite-ligne { gap: var(--maq-tete-ecart); padding: 0; }
+.accueil.maq .identite-ligne .player-avatar.big { font-size: var(--maq-avatar); }
+.accueil.maq .identite-nom { font-size: var(--maq-nom); }
+.accueil.maq .identite-texte { gap: 2px; }
+.accueil.maq .xp-mince { margin-top: 2px; }
+.accueil.maq .bouton-des-amis { min-width: calc(var(--maq-amis) + 6px); gap: 2px; }
+.accueil.maq .bouton-des-amis-rond { width: var(--maq-amis); height: var(--maq-amis); }
+.accueil.maq .bouton-des-amis-rond .icon { width: 18px; height: 18px; }
+/* « À la une » : la même affiche, à la hauteur d'une rangée — son dessin à l'échelle, ses trois lignes serrées. */
+.accueil.maq .haut-accueil { gap: 8px; }
+.accueil.maq .haut-en-chemin { height: calc(var(--maq-une) + 8px + var(--maq-missions)); }
+.accueil.maq .haut-en-chemin.sans-une { height: var(--maq-missions); }
+.accueil.maq .une { height: var(--maq-une); padding: 0 12px 0 var(--maq-une-retrait); border-radius: calc(10px + 8px * var(--maq-une-echelle)); }
+.accueil.maq .une-visuel { scale: var(--maq-une-echelle); transform-origin: left bottom; }
+.accueil.maq .une-texte { gap: 0; }
+.accueil.maq .une-nom { font-size: var(--maq-une-nom); }
+.accueil.maq .une-detail { display: block; overflow: hidden; font-size: var(--maq-une-detail); white-space: nowrap; text-overflow: ellipsis; }
+.accueil.maq .une-aller { display: var(--maq-une-fleche); }
+/* Les missions : deux lignes serrées, la seconde coupée au bout. */
+.accueil.maq .missions-ligne { gap: 10px; min-height: var(--maq-missions); padding: 5px 12px; }
+.accueil.maq .missions-icone { width: var(--maq-missions-icone); height: var(--maq-missions-icone); }
+.accueil.maq .missions-icone .icon { width: calc(var(--maq-missions-icone) * 0.56); height: calc(var(--maq-missions-icone) * 0.56); }
+.accueil.maq .missions-texte { gap: 0; }
+.accueil.maq .missions-tete b { font-size: var(--maq-missions-titre); line-height: 1.2; }
+.accueil.maq .missions-detail { overflow: hidden; font-size: var(--maq-missions-detail); line-height: 1.25; white-space: nowrap; text-overflow: ellipsis; }
+.accueil.maq .mission-anneau { width: calc(var(--maq-missions-icone) * 0.56); height: calc(var(--maq-missions-icone) * 0.56); }
+
+/* Un écran moyen : les boutons d'un cran au-dessus, le haut moyen. */
+@media (min-height: 720px) {
+  .accueil.maq {
+    --maq-rang: 50px;
+    --maq-tuile: 78px;
+    --maq-ami: 56px;
+    --maq-icone: 36px;
+    /* « Le Cabinet de curiosités » tient encore sur sa ligne à côté d'une pastille, en 360 de large. */
+    --maq-titre: 1.15rem;
+    --maq-detail: 0.8rem;
+    --maq-ecart: 12px;
+    --maq-serre: 8px;
+    --maq-une: 4.125rem;
+    --maq-une-echelle: 0.78;
+    --maq-une-retrait: 84px;
+    --maq-une-nom: 1.2rem;
+    --maq-une-detail: 0.76rem;
+    --maq-une-fleche: grid;
+    --maq-missions: 3.25rem;
+    --maq-missions-icone: 32px;
+    --maq-missions-titre: 0.92rem;
+    --maq-missions-detail: 0.76rem;
+  }
+  .accueil.maq .maq-amis > .gros-bouton .gros-detail { display: -webkit-box; }
+}
+/* Un grand écran : le haut d'aujourd'hui, à ses mesures. */
+@media (min-height: 820px) {
+  .accueil.maq {
+    --maq-rang: 54px;
+    --maq-tuile: 84px;
+    --maq-ami: 60px;
+    --maq-icone: 40px;
+    --maq-titre: 1.22rem;
+    --maq-detail: 0.84rem;
+    --maq-ecart: 16px;
+    --maq-serre: 10px;
+  }
+  .accueil.maq:not(:has(.gros-principal, .lendemain, .installer, .annonces-admin)) {
+    --maq-tete: 0px;
+    --maq-tete-ecart: 14px;
+    --maq-avatar: 2.4rem;
+    --maq-nom: 1.45rem;
+    --maq-amis: 44px;
+    --maq-une: 5rem;
+    --maq-une-echelle: 1;
+    --maq-une-retrait: 100px;
+    --maq-une-nom: 1.3rem;
+    --maq-une-detail: 0.78rem;
+    --maq-missions: 3.75rem;
+    --maq-missions-icone: 36px;
+    --maq-missions-titre: 0.95rem;
+    --maq-missions-detail: 0.8rem;
+  }
+  .accueil.maq .gros-bouton { gap: 12px; padding: 5px 14px; }
+  .accueil.maq .maq-grille > .gros-bouton { column-gap: 10px; row-gap: 5px; padding: 10px 12px; }
+  .accueil.maq .maq-grille > .gros-bouton .gros-detail { font-size: 0.8rem; }
+}
